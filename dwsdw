            -- Skeleton visibility
            for bone_name, _ in pairs(skeleton_order) do
                local skel_line = obj["skeleton_"..bone_name]
                if skel_line then skel_line.Visible = settings.skeleton end
            end
            dist.Visible   = settings.dist
            weapon.Visible = settings.weapon
        end

        plr.connection = cheat.utility.new_renderstepped(function(delta)
            if not _esp_update then return end
            local plr = loaded_plrs[player]
            if not plr then return end
            if not settings.enabled then return plr:togglevis(false) end
            local character = isnpc and player or (not isnpc and player.Character)
            local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
            local head      = character and character:FindFirstChild("Head")
            local is_heli = isnpc and character and (character.Name=="MI24V" or character.Name=="BTR80")
            if is_heli then
                head = character:FindFirstChild("CollisionPilot", true) or character:FindFirstChild("Mi24_Prop_M", true)
                humanoid = humanoid or { Health=character:GetAttribute("Health") or 1000, MaxHealth=1000, Parent=character }
            end
            if not (character and head and humanoid and character.Parent and (head.Parent or is_heli) and (humanoid.Parent or is_heli)) then
                if main_settings.infiniterange and not isnpc then
                    local rp_plr = ReplicatedStorage:FindFirstChild("Players")
                    rp_plr = rp_plr and rp_plr:FindFirstChild(player.Name)
                    local plrstatus = rp_plr and rp_plr:FindFirstChild("Status")
                    local uac = plrstatus and plrstatus:FindFirstChild("UAC")
                    local worldpos = uac and uac:GetAttribute("LastVerifiedPos")
                    local screenpos, onscreen
                    if typeof(worldpos) == "Vector3" then
                        screenpos, onscreen = camera:WorldToViewportPoint(worldpos)
                    end
                    if not (onscreen) then
                        realname.Visible = false
                        return plr:togglevis(false)
                    end
                    realname.Position = Vector2.new(screenpos.X, screenpos.Y)
                    realname.Text = player.Name .. " ["..math.round((worldpos - camera.CFrame.p).Magnitude / 3).."]"
                    plr:togglevis(false)
                    realname.Visible = true
                    return
                end
                realname.Visible = false
                return plr:togglevis(false)
            end
            local _, onScreen = camera:WorldToViewportPoint(head.Position)
            if not onScreen then return plr:togglevis(false) end
            local dist3d = (camera.CFrame.p - head.Position).Magnitude
            local health = humanoid.Health
            if health <= 0 then return plr:togglevis(false) end
            local maxhealth = humanoid.MaxHealth

            if plr.last_character ~= character then
                plr.last_character = character
                plr.body_parts = {}
                local check_desc = isnpc and (character.Name=="MI24V" or character.Name=="BTR80")
                for _, part in (check_desc and character:GetDescendants() or character:GetChildren()) do
                    if part:IsA("BasePart") and isBodyPart(part.Name) then
                        plr.body_parts[#plr.body_parts+1] = part
                    end
                end
            end
            if not plr.body_parts or #plr.body_parts <= 0 then return plr:togglevis(false) end
            local corners
            if settings.box_mode == "Static Rectangle" then
                local hrp = character:FindFirstChild("HumanoidRootPart") or head
                if not hrp then return plr:togglevis(false) end
                corners = calculateStaticBox(hrp.Position)
            else
                corners = calculateCorners(getBoundingBox(plr.body_parts))
            end
            plr:togglevis(true)
            cham.Adornee = character

            -- FIX: per-frame Visible — togglevis cache мешает live-toggle
            -- (если игрок уже на экране, setvis_cache==true и togglevis(true) early-returns)
            box.Visible         = settings.box
            box_outline.Visible = settings.box_outline
            box_fill.Visible    = settings.box_fill
            realname.Visible    = settings.realname
            dist.Visible        = settings.dist
            weapon.Visible      = settings.weapon
            -- FIX: DrawingFix compat — если загружен DrawingFix, outline'ы нужно
            -- сместить на 1px и увеличить размер на 2px (иначе невидимы/обрезаны)
            local _df = getgenv().DrawingFix
            local pos = corners.topLeft
            local size = corners.bottomRight - corners.topLeft
            box.Position        = pos
            box.Size            = size
            if _df then
                box_outline.Position = pos - Vector2.new(1, 1)
                box_outline.Size     = size + Vector2.new(2, 2)
            else
                box_outline.Position = pos
                box_outline.Size     = size
            end
            box_fill.Position   = pos
            box_fill.Size       = size

            -- High K/D marker (cheater detector): парсим WipeStatistics/Statistics, K/D > 5 → [CHEATER] + красный outline
            local is_cheater = false
            if not isnpc and settings.high_kd_marker then
                if not plr._kd_cached_time or (os.clock() - plr._kd_cached_time) > 2 then
                    plr._kd_cached_time = os.clock()
                    local pfolder = ReplicatedStorage:FindFirstChild("Players") and ReplicatedStorage.Players:FindFirstChild(player.Name)
                    local stats_obj = pfolder and (pfolder:FindFirstChild("WipeStatistics", true) or pfolder:FindFirstChild("Statistics", true))
                    if stats_obj then
                        local kills = stats_obj:GetAttribute("Kills") or 0
                        local deaths = stats_obj:GetAttribute("Deaths") or 0
                        local ratio = kills / math.max(1, deaths)
                        plr._kd_is_cheater = ratio > 5
                    else
                        plr._kd_is_cheater = false
                    end
                end
                is_cheater = plr._kd_is_cheater or false
            end
            if is_cheater then
                box_outline.Color = settings.high_kd_outline_color
                box_outline.Transparency = 0
            end

            local healthbar_top_y = corners.topLeft.Y
            if (corners.bottomLeft.Y - corners.topLeft.Y) < 5 then
                healthbar_top_y = corners.bottomLeft.Y - 5
            end
            local top_text_y = math.min(corners.topLeft.Y, healthbar_top_y)
            realname.Position = Vector2.new((corners.topLeft.X+corners.topRight.X)*0.5, top_text_y) - Vector2.yAxis - (Vector2.yAxis * realname.TextBounds.Y) - Vector2.new(0,2)
            local name_str = player.Name
            if not isnpc and settings.high_kd_marker and plr._kd_is_cheater then
                name_str = "[CHEATER] " .. name_str
            end
            -- Staff Detector: show [MOD] prefix for detected staff
            if not isnpc and cheat.staff_detected and cheat.staff_detected[player] then
                local sd_info = cheat.staff_detected[player]
                local sd_prefix = "[MOD] "
                local sd_color = Color3.fromRGB(255, 80, 80)
                if sd_info.type == "tester" then
                    sd_prefix = "[TESTER] "
                    sd_color = Color3.fromRGB(100, 200, 255)
                elseif sd_info.type == "content_creator" then
                    sd_prefix = "[CREATOR] "
                    sd_color = Color3.fromRGB(255, 200, 100)
                elseif sd_info.type == "alt_mod" then
                    sd_prefix = "[MOD?] "
                    sd_color = Color3.fromRGB(255, 150, 50)
                end
                name_str = sd_prefix .. name_str
                realname.Color = sd_color
            end
            realname.Text = name_str

            -- Friend ESP coloring — override realname color for friends
            if not isnpc and cheat.is_friend(player) then
                realname.Color = cheat.friend_color
            end

            dist.Text     = math.round(dist3d/3).." meters"
            dist.Position = (corners.bottomLeft + corners.bottomRight) * 0.5
            local _cl = os.clock()
            if not plr._gun_cache_time or (_cl - plr._gun_cache_time) > 0.5 then
                plr._gun_cache_time = _cl
                plr._gun_cache_text = isnpc and "" or esp_table.get_gun(player)
            end
            weapon.Text = plr._gun_cache_text or ""
            weapon.Position = dist.Position + (dist.Visible and Vector2.yAxis * dist.TextBounds.Y - Vector2.new(0,2) or Vector2.zero)

            healthtext.Visible = false
            local hp = math.clamp(health/maxhealth, 0, 1)
            local bar_start = corners.bottomLeft - Vector2.new(6,0)
            local bar_end   = corners.topLeft    - Vector2.new(6,0)
            if (bar_start.Y - bar_end.Y) < 5 then bar_end = bar_start - Vector2.new(0,5) end
            local gc = settings.health_color_top:Lerp(settings.health_color_bottom, 0.5)
            for i=1,6 do
                local glow = obj["health_bar_glow_"..i]
                local ct, cb = obj["health_bar_glow_cap_top_"..i], obj["health_bar_glow_cap_bottom_"..i]
                if settings.health and hp > 0 then
                    local th = (i/6) * settings.health_glow_size
                    local tr = 0.3 - (i*0.04)
                    glow.Visible, glow.From, glow.To = true, bar_start, bar_start:Lerp(bar_end, hp)
                    glow.Color, glow.Thickness, glow.Transparency = gc, th, tr
                    ct.Visible, ct.Position, ct.Color, ct.Radius, ct.Transparency = true, bar_start:Lerp(bar_end, hp), gc, th/2, tr
                    cb.Visible, cb.Position, cb.Color, cb.Radius, cb.Transparency = true, bar_start, gc, th/2, tr
                else
                    glow.Visible, ct.Visible, cb.Visible = false, false, false
                end
            end
            if settings.health and hp > 0 then
                obj.health_bar_cap_top.Visible    = true
                obj.health_bar_cap_top.Position   = bar_start:Lerp(bar_end, hp)
                obj.health_bar_cap_top.Color      = settings.health_color_top:Lerp(settings.health_color_bottom, 1-hp)
                obj.health_bar_cap_top.Radius     = settings.health_thickness/2
                obj.health_bar_cap_bottom.Visible = true
                obj.health_bar_cap_bottom.Position= bar_start
                obj.health_bar_cap_bottom.Color   = settings.health_color_bottom
                obj.health_bar_cap_bottom.Radius  = settings.health_thickness/2
            else
                obj.health_bar_cap_top.Visible, obj.health_bar_cap_bottom.Visible = false, false
            end
            for i=1,10 do
                local sl = obj["health_bar_"..i]
                if settings.health and i <= math.ceil(hp*10) then
                    sl.Visible = true
                    local ss = bar_start:Lerp(bar_end, (i-1)/10)
                    local se = bar_start:Lerp(bar_end, i/10)
                    if i == math.ceil(hp*10) then se = bar_start:Lerp(bar_end, hp) end
                    sl.From, sl.To = ss, se
                    sl.Color = settings.health_color_top:Lerp(settings.health_color_bottom, 1-(i/10))
                else
                    sl.Visible = false
                end
            end

            cham.Adornee = character
            cham.Enabled = settings.chams
            if settings.chams then
                if settings.chams_visible_split then
                    cham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    cham.DepthMode = settings.chams_visible_only and Enum.HighlightDepthMode.Occluded
                        or Enum.HighlightDepthMode.AlwaysOnTop
                end
                local int_off = (math.clamp(settings.chams_intensity or 0.5, 0, 1) - 0.5) * 2
                if settings.chams_health_reactive and not settings.chams_rainbow then
                    local hpp = math.clamp(health/math.max(maxhealth, 1), 0, 1)
                    cham.FillColor = Color3.fromHSV(hpp*(1/3), math.clamp(settings.chams_saturation or 1, 0, 1), 1)
                    cham.FillTransparency = math.clamp(settings.chams_fill_color[2] + int_off, 0, 0.99)
                elseif settings.chams_visible_split then
                    -- Per-character visibility check (was: silent_aim.isvisible — colored EVERY player by current aim target)
                    local vis = false
                    local hrp_part = character:FindFirstChild("HumanoidRootPart") or head
                    if hrp_part then
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.FilterDescendantsInstances = { character, get_nocollision(), Camera }
                        local cast = workspace:Raycast(camera.CFrame.p, hrp_part.Position - camera.CFrame.p, rp)
                        vis = (not cast) or (cast.Instance and cast.Instance:IsDescendantOf(character))
                    end
                    if vis then
                        cham.FillColor, cham.FillTransparency = settings.chams_fill_color[1], math.clamp(settings.chams_fill_color[2]+int_off, 0, 0.99)
                    else
                        cham.FillColor, cham.FillTransparency = settings.chams_occluded_color[1], math.clamp(settings.chams_occluded_color[2]+int_off, 0, 0.99)
                    end
                elseif not settings.chams_rainbow and not settings.chams_pulse then
                    cham.FillColor        = settings.chams_fill_color[1]
                    cham.FillTransparency = math.clamp(settings.chams_fill_color[2]+int_off, 0, 0.99)
                end
                cham.OutlineColor        = settings.chamsoutline_color[1]
                cham.OutlineTransparency = settings.chams_outline and math.clamp(settings.chamsoutline_color[2]+int_off, 0, 0.99) or 1
            end

            -- SKELETON ESP render
            if settings.skeleton then
                -- Cache bone→parent→Line mapping on character change.
                -- FIX: plr.last_character may be nil and _skel_char_cached_for may be nil,
                -- which makes the ~= check return false (both nil). Compare to a sentinel
                -- instead, and always (re)build when character changes OR cache is empty.
                if plr.last_character ~= plr._skel_char_cached_for or not plr._skel_parts then
                    plr._skel_char_cached_for = plr.last_character
                    plr._skel_parts = {}
                    if character then
                        for _, part in ipairs(character:GetChildren()) do
                            local parent_name = skeleton_order[part.Name]
                            if parent_name then
                                local parent_instance = character:FindFirstChild(parent_name)
                                local line = obj["skeleton_"..part.Name]
                                if parent_instance and line then
                                    plr._skel_parts[#plr._skel_parts + 1] = { part = part, parent = parent_instance, line = line }
                                end
                            end
                        end
                    end
                end
                if plr._skel_parts then
                    for i = 1, #plr._skel_parts do
                        local entry = plr._skel_parts[i]
                        if entry.part.Parent and entry.parent.Parent then
                            local p1 = camera:WorldToViewportPoint(entry.part.Position)
                            local p2 = camera:WorldToViewportPoint(entry.parent.Position)
                            if p1.Z > 0 and p2.Z > 0 then
                                entry.line.From = Vector2.new(p1.X, p1.Y)
                                entry.line.To   = Vector2.new(p2.X, p2.Y)
                                entry.line.Visible = true
                            else
                                entry.line.Visible = false
                            end
                        else
                            entry.line.Visible = false
                        end
                    end
                end
            else
                -- Hide all skeleton lines when disabled
                if plr._skel_parts then
                    for i = 1, #plr._skel_parts do
                        plr._skel_parts[i].line.Visible = false
                    end
                end
            end
        end)
        plr:forceupdate()
    end

    local function create_object_esp(model, modelname)
        if not model then return end
        local name = identify_model(model, modelname)
        if not name then return end
        local icon_asset = (modelname == "dropped_item") and get_item_icon(model.Name) or false
        local objs = { name = create_obj("Text", { Center=true, Visible=false, Text=name }) }
        if icon_asset then
            objs.icon = create_obj("Image", { Visible=false, Size=Vector2.new(24, 24) })
        end
        loaded_plrs[model] = { obj = objs }
        local plr = loaded_plrs[model]
        local label = plr.obj.name
        local settings_ref = (modelname == "dropped_item") and esp_table.settings.dropped_item or esp_table.settings.corpse
        local setvis = false
        plr.connection = cheat.utility.new_heartbeat(function()
            if not settings_ref.enabled then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            if modelname == "dropped_item" then
                local is_gun = weapon_list[model.Name] == true
                if settings_ref.only_guns and not is_gun then
                    if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                    return
                end
            end
            local mp = get_mainpart(model, modelname)
            local wp = mp and mp.Position or model:GetPivot().Position
            local pos, on = worldToScreen(wp)
            if not on then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            local s = ""
            if settings_ref.name then s = name end
            if settings_ref.distance then
                local d = math.floor((camera.CFrame.p - wp).Magnitude/4)
                s = (s ~= "" and (s.." ["..d.."m]")) or ("["..d.."m]")
            end
            if s == "" then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            label.Text    = s
            label.Position = pos
            label.Size    = esp_table.main_settings.textSize
            label.Font    = esp_table.main_settings.textFont
            label.Color   = settings_ref.color
            label.Outline = settings_ref.outline
            label.OutlineColor = settings_ref.outline_color
            if plr.obj.icon then
                local show_icon = settings_ref.show_icon and icon_asset ~= false
                plr.obj.icon.Visible = show_icon
                if show_icon then
                    plr.obj.icon.Position = Vector2.new(pos.X - 12, pos.Y + 14)
                end
            end
            if not setvis then for _,v in plr.obj do v.Visible = true end; setvis = true end
        end)
    end

    local function destroy_esp(player)
        if not loaded_plrs[player] then return end
        loaded_plrs[player].connection:Disconnect()
        for _,v in loaded_plrs[player].obj do v:Remove() end
        if loaded_plrs[player].chams_object then loaded_plrs[player].chams_object:Destroy() end
        loaded_plrs[player] = nil
    end

    function esp_table.load()
        if esp_table.__loaded then return end
        local function shortcut(is_obj, remove, default_name)
            return function(model)
                if remove then
                    destroy_esp(model)
                elseif is_obj then
                    -- auto-detect corpse vs dropped_item by presence of Humanoid
                    local mname = default_name
                    if model:FindFirstChildOfClass("Humanoid") then
                        mname = "corpse"
                    else
                        mname = "dropped_item"
                    end
                    create_object_esp(model, mname)
                else
                    create_esp(model)
                end
            end
        end
        for _, v in next, Players:GetPlayers() do
            if v ~= lplr then create_esp(v) end
        end
        local az = ws:FindFirstChild("AiZones")
        if az then
            for _, folder in next, az:GetChildren() do
                for _, npc in next, folder:GetChildren() do create_esp(npc, true) end
            end
        end
        local dropped = ws:FindFirstChild("DroppedItems")
        if dropped then
            for _, item in next, dropped:GetChildren() do
                local mname = item:FindFirstChildOfClass("Humanoid") and "corpse" or "dropped_item"
                create_object_esp(item, mname)
            end
        end
        esp_table.objectAdded = { Players.PlayerAdded:Connect(shortcut(false, false)) }
        esp_table.objectRemoving = { Players.PlayerRemoving:Connect(shortcut(false, true)) }
        if dropped then
            table.insert(esp_table.objectAdded,    dropped.ChildAdded:Connect(shortcut(true, false)))
            table.insert(esp_table.objectRemoving, dropped.ChildRemoved:Connect(shortcut(true, true)))
        end
        if az then
            for _, z in pairs(az:GetChildren()) do
                table.insert(esp_table.objectAdded,    z.ChildAdded:Connect(shortcut(false, false)))
                table.insert(esp_table.objectRemoving, z.ChildRemoved:Connect(shortcut(false, true)))
            end
        end
        esp_table.__loaded = true
    end

    function esp_table.unload()
        if not esp_table.__loaded then return end
        for p in next, loaded_plrs do destroy_esp(p) end
        for _, c in next, esp_table.objectAdded or {} do c:Disconnect() end
        for _, c in next, esp_table.objectRemoving or {} do c:Disconnect() end
        esp_table.__loaded = false
    end

    function esp_table.get_gun(player)
        local gun = "None"
        local P = ReplicatedPlayers:FindFirstChild(player.Name)
        if P and P:FindFirstChild("Status") and P.Status:FindFirstChild("GameplayVariables")
            and P.Status.GameplayVariables:FindFirstChild("EquippedTool")
            and P.Status.GameplayVariables.EquippedTool.Value then
            gun = tostring(P.Status.GameplayVariables.EquippedTool.Value)
        end

        if item_finder_esp_enabled then
            -- FIX #4: selected_finder_items is a dict from the multi-select dropdown.
            -- Было `#selected_finder_items > 0` → всегда 0 для dict.
            -- Стало `next(...) ~= nil` — универсальная проверка.
            if selected_finder_items and next(selected_finder_items) ~= nil then
                local p_inv = P and P:FindFirstChild("Inventory")
                if p_inv then
                    local found = {}
                    local function scan(item)
                        if selected_finder_items[item.Name] then
                            table.insert(found, item.Name)
                        end
                        local inner = item:FindFirstChild("Inventory")
                        if inner then
                            for _, subitem in ipairs(inner:GetChildren()) do scan(subitem) end
                        end
                        local atts = item:FindFirstChild("Attachments")
                        if atts then
                            for _, att in ipairs(atts:GetChildren()) do
                                if selected_finder_items[att.Name] then
                                    table.insert(found, att.Name)
                                end
                            end
                        end
                    end
                    for _, item in ipairs(p_inv:GetChildren()) do scan(item) end
                    if #found > 0 then
                        local unique = {}
                        for _, v in ipairs(found) do unique[v] = true end
                        local unique_list = {}
                        for k in pairs(unique) do table.insert(unique_list, k) end
                        gun = gun .. " | [" .. table.concat(unique_list, ", ") .. "]"
                    end
                end
            end
        end
        return gun
    end

    function esp_table.icaca()
        for _, v in pairs(loaded_plrs) do
            v.last_chams_update = 0
            task.spawn(function() if v.forceupdate then v:forceupdate() end end)
        end
    end

    do
        local h1, h2, sp = 0, 0, 0
        RunService:BindToRenderStep("ZalupaChamsRS", Enum.RenderPriority.Last.Value + 2, function(delta)
            local s = esp_table.settings and esp_table.settings.enemy
            if not s then return end
            if not (s.chams_rainbow or s.chams_pulse or s.chams_outline_pulse or s.chams_strobe) then return end
            h1 = (h1 + delta*0.3) % 1
            h2 = (h2 + delta*0.5) % 1
            sp = (sp + delta*12) % (2*math.pi)
            local sat = math.clamp(s.chams_saturation or 1, 0, 1)
            local rc  = Color3.fromHSV(h1, sat, 1)
            local oc  = Color3.fromHSV(h2, sat, 1)
            local pa  = (math.sin(tick()*3)+1)/2
            local sa  = (math.sin(sp)>0) and 0.0 or 0.99
            local wire= s.chams_material == "Wireframe"
            local io  = (math.clamp(s.chams_intensity or 0.5,0,1)-0.5)*2
            for _, pd in next, loaded_plrs do
                local ch = pd.chams_object
                if not (ch and ch.Enabled) then continue end
                if s.chams_strobe then
                    if not wire then ch.FillTransparency = sa end
                    if s.chams_outline then ch.OutlineTransparency = sa end
                    if s.chams_rainbow then
                        ch.FillColor = rc
                        if s.chams_outline then ch.OutlineColor = rc end
                    end
                    continue
                end
                if s.chams_rainbow and not s.chams_health_reactive then ch.FillColor = rc end
                if s.chams_outline_pulse and s.chams_outline then
                    ch.OutlineColor = oc
                    ch.OutlineTransparency = math.clamp((math.sin(tick()*5)+1)/2 + io, 0, 0.99)
                elseif s.chams_rainbow and s.chams_outline then
                    ch.OutlineColor = rc
                end
                if s.chams_pulse and not wire and not s.chams_health_reactive and not s.chams_visible_split then
                    ch.FillTransparency = math.clamp(pa + io, 0, 0.99)
                end
            end
        end)
    end

    cheat.EspLibrary = esp_table
end
