-- [BLOCK 12b] SKIN CHANGER (weapons + knives only)
-- Фильтр: ItemType == RangedWeapon или Melee. Аттачмент-эдитор выкинут.
-- Обёрнуто в IIFE для изоляции регистров (Luau limit 200 locals/function)
-- do...end не помогает — нужен настоящий function scope
;(function()
local function skins_folder()
    return ReplicatedStorage:FindFirstChild("Skins")
end
local function items_list_skins()
    return ReplicatedStorage:FindFirstChild("ItemsList")
end

-- Apply skin textures/materials to a model's parts
cheat.dressSkin = function(model, item_name, selected_skin)
    local folder = skins_folder()
    if not model or not folder then return end
    local item = folder:FindFirstChild(item_name)
    local skin = item and item:FindFirstChild(selected_skin)
    if not skin then return end
    local textures = skin:FindFirstChild("Textures")
    local materials = skin:FindFirstChild("Materials")
    if not textures and not materials then return end
    -- FIX: use GetDescendants instead of manual 2-level walk so deep attachment hierarchies
    -- (e.g. AKMN receiver → barrel weld → front sight → gas block) all get skinned.
    -- Was: model:GetChildren() + child:GetChildren() (only 2 levels deep, missed nested parts).
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then
            local key = part:GetAttribute("Skinnable")
            local texture = key and textures and textures:FindFirstChild(key)
            if texture then
                pcall(function()
                    for _, old in part:GetChildren() do
                        if old:IsA(texture.ClassName) then old:Destroy() end
                    end
                    local copy = texture:Clone()
                    copy.Name = "SurfaceAppearance"
                    copy.Parent = part
                    local transparency = copy:GetAttribute("Transparency")
                    if transparency and part.Transparency ~= 1 then part.Transparency = transparency end
                end)
            end
            local material = key and materials and materials:FindFirstChild(key)
            if material then
                pcall(function()
                    for _, old in part:GetChildren() do
                        if old:IsA("SurfaceAppearance") then old:Destroy() end
                    end
                    local color = material:GetAttribute("Color")
                    local transparency = material:GetAttribute("Transparency")
                    local material_name = material:GetAttribute("Name")
                    if color then part.Color = color end
                    if transparency then part.Transparency = transparency end
                    if material_name and Enum.Material[material_name] then part.Material = Enum.Material[material_name] end
                end)
            end
        end
    end
end

-- FIX: apply dressSkin to ALL Model instances inside parent (not just the first).
-- Composite weapons (AKMN/M4/FAL) live in Camera as multiple sibling Models —
-- receiver, stock, front, handle, magazine — each a separate Model with its own
-- item_id (e.g. "StockAKMN", "FrontAKMN", "762x39MAG"). The skin textures for
-- each attachment live in Skins/<attachment_item_id>/<skin>/Textures — NOT in
-- Skins/<weapon_item_id>/<skin>/Textures. So for each Model in Camera we must:
--   1) detect its real item_id (via child Item ObjectValue, attributes, or Model.Name)
--   2) apply dressSkin(model, attachment_item_id, skin) — that's where the Textures live
--   3) also try dressSkin(model, parent_weapon_item_id, skin) as fallback — some
--      attachments' BaseParts use Skinnable keys defined in the parent weapon's skin

-- Detect the ItemsList item_id for a Model in Camera/Tool.
-- Tries: child "Item" (ObjectValue.Value.Name or StringValue.Value), common
-- attributes, then Model.Name (if it matches an ItemsList entry, attachments
-- often do — e.g. "StockAKMN", "FrontAKMN", "762x39MAG").
local function get_model_item_id(model)
    if not model or not model:IsA("Model") then return nil end
    -- 1. child "Item" (ObjectValue pointing at ItemsList entry, or StringValue)
    local it = model:FindFirstChild("Item")
    if it then
        if it:IsA("ObjectValue") and it.Value then
            local v = it.Value
            -- SpecialSkinItem attribute overrides the ref name (mirrors skin_key_of)
            local props = v:FindFirstChild("ItemProperties")
            local special = props and props:GetAttribute("SpecialSkinItem")
            if type(special) == "string" and special ~= "" then return special end
            return v.Name
        end
        if it:IsA("StringValue") and it.Value ~= "" then return it.Value end
        if it:IsA("StringValue") and it.Name ~= "Item" then return it.Name end
        -- "Item" child whose own Name matches an ItemsList entry (e.g. vm.Item.Name == "AKMN")
        local list = items_list_skins()
        if list and list:FindFirstChild(it.Name) then return it.Name end
    end
    -- 2. attributes
    for _, attr_name in ipairs({"ItemName", "ItemId", "SkinItem", "SpecialSkinItem"}) do
        local attr = model:GetAttribute(attr_name)
        if type(attr) == "string" and attr ~= "" then return attr end
    end
    -- 3. Model.Name itself — attachments in the game are usually named exactly like
    --    their ItemsList entry (StockAKMN, FrontAKMN, HandleAKMN, 762x39MAG, etc.)
    local list = items_list_skins()
    if list and list:FindFirstChild(model.Name) then return model.Name end
    -- Last resort: Model.Name (dressSkin will no-op if no matching skin folder exists)
    return model.Name
end

-- Iterates parent's direct Model children, detects each one's item_id, calls dressSkin
-- with the detected item_id (and weapon_item as fallback). Works for the case where
-- attachments are sibling Models of vm in Camera.
local function dressSkin_all_models(parent, weapon_item, skin)
    if not parent then return end
    for _, m in ipairs(parent:GetChildren()) do
        if m:IsA("Model") then
            -- Detect this Model's actual item_id — attachments have their own.
            local part_item = get_model_item_id(m) or weapon_item
            -- 1. Apply with the attachment's own item_id (skins live in Skins/<attachment_id>/<skin>/).
            pcall(cheat.dressSkin, m, part_item, skin)
            -- 2. Also try with the parent weapon's item_id (in case attachment BaseParts
            --    reuse Skinnable keys defined in the parent weapon's Textures).
            if part_item ~= weapon_item then
                pcall(cheat.dressSkin, m, weapon_item, skin)
            end
        end
    end
end

-- FIX (dj regression "скин с ручки/ствола/приклада/магазина пропадает после holster"):
-- The vm contains BaseParts from MULTIPLE item_ids (receiver + each
-- attachment). dressSkin_all_models above only catches attachment Models that are
-- SIBLINGS of vm in Camera — but on re-equip they may be nested INSIDE vm, or the
-- async loading may not have them as Models at the moment we fire. This function
-- takes a different approach: walk ALL BaseParts in parent's descendants, collect
-- unique Skinnable keys, then for each key find which item folder in Skins/ has
-- Textures/<key> for the chosen skin, and call dressSkin(parent, item_folder, skin).
-- dressSkin itself uses parent:GetDescendants() so one call per item_id covers all
-- matching BaseParts regardless of nesting. Works whether attachments are nested,
-- siblings, or async-loaded after vm.
--
-- FIX (dj regression "скин накладывается криво и на руки"):
-- dressSkin_recursive used to call dressSkin(PARENT, item_folder, skin) on the WHOLE
-- parent (Camera or Character). Because parent contains MANY Models (weapon + gloves +
-- shirt + pants + ...), and they all have BaseParts tagged with Skinnable="Base",
-- dressSkin iterated ALL of them and applied the matching Textures/Base to whatever
-- BasePart had that key. Result: gloves/shirt/pants got AKMN's skin texture, and if
-- multiple Skins/*/<skin>/Textures had a "Base" key, the LAST one to be processed
-- overwrote earlier ones — receiver could end up with CombatGloves' texture.
--
-- Fix: scope the dressSkin call to the SPECIFIC Model that owns the matched Skinnable
-- key, not the entire parent. We track (model → set of keys present) by walking
-- descendants with an ancestor check. Then for each item_folder in Skins/ we find
-- which Models have keys that match it, and call dressSkin(model, item_folder, skin)
-- on JUST those Models. dressSkin iterates that Model's descendants and only touches
-- BaseParts inside it — so gloves/shirt/pants stay untouched.
local function dressSkin_recursive(parent, weapon_item, skin)
    if not parent then return end

    -- Pass 1: collect (BasePart → its owning Model). Walk descendants; for each
    -- BasePart with a Skinnable attribute, find the nearest Model ancestor that is
    -- a direct child of parent. We bucket keys by that Model so we can scope calls.
    local model_keys = {}        -- model → { [key] = true, ... }
    local key_to_models = {}     -- key → { [model] = true, ... }
    for _, p in parent:GetDescendants() do
        if p:IsA("BasePart") then
            local k = p:GetAttribute("Skinnable")
            if k then
                -- Find the owning Model: walk up parents until we hit a child of `parent`.
                local owner = nil
                local cur = p.Parent
                while cur and cur ~= parent do
                    if cur:IsA("Model") then owner = cur end
                    cur = cur.Parent
                end
                -- If no Model ancestor found, treat the BasePart itself as its own bucket
                -- (dressSkin can be called with a BasePart instead of a Model — it just
                -- iterates descendants, which for a BasePart is empty, then the part itself
                -- is processed in the for loop, since GetDescendants skips the part).
                -- To support this case we wrap the BasePart in a fake "owner" sentinel.
                local bucket = owner or p
                if not model_keys[bucket] then model_keys[bucket] = {} end
                model_keys[bucket][k] = true
                if not key_to_models[k] then key_to_models[k] = {} end
                key_to_models[k][bucket] = true
            end
        end
    end
    if next(model_keys) == nil then return end  -- no Skinnable parts at all

    local f = skins_folder()
    if not f then return end

    -- Pass 2: for each item_folder in Skins/, find which Models own keys that match
    -- Textures/<key> or Materials/<key>. Build (model → list of matching item_folder_names).
    -- We collect ALL matches per model (not just first), so Pass 3 can pick weapon_item
    -- first when it's available for a given model (avoids CombatGloves' Textures/Base
    -- winning over AKMN's Textures/Base for the AKMN receiver model).
    local model_to_items = {}  -- model → array of item_folder_names (insertion order = Skins/ iter order)
    for _, item_folder in f:GetChildren() do
        local name = item_folder.Name
        local skin_folder = item_folder:FindFirstChild(skin)
        if skin_folder then
            local tx = skin_folder:FindFirstChild("Textures")
            local mt = skin_folder:FindFirstChild("Materials")
            local matched_keys = {}
            if tx then
                for key in pairs(key_to_models) do
                    if tx:FindFirstChild(key) then matched_keys[key] = true end
                end
            end
            if mt then
                for key in pairs(key_to_models) do
                    if mt:FindFirstChild(key) then matched_keys[key] = true end
                end
            end
            if next(matched_keys) ~= nil then
                -- For every Model that owns any matched key, append this item_folder name.
                for key in pairs(matched_keys) do
                    for model in pairs(key_to_models[key]) do
                        if not model_to_items[model] then model_to_items[model] = {} end
                        -- Avoid duplicates if multiple keys from same item_folder match the same model.
                        local list = model_to_items[model]
                        local already = false
                        for _, n in ipairs(list) do if n == name then already = true break end end
                        if not already then list[#list + 1] = name end
                    end
                end
            end
        end
    end

    -- Pass 3: call dressSkin(model, item_folder, skin) for each (model, items) pair.
    -- Priority (highest first):
    --   1. model_id (model's own detected item_id — covers CombatGloves Model getting
    --      CombatGloves skin, AKMN Model getting AKMN skin, StockAKMN Model getting
    --      StockAKMN skin if it has one for this skin name).
    --   2. weapon_item (parent weapon fallback) — ONLY if the Model has no own item
    --      folder in Skins/ at all. This covers nested attachment Models in vm whose
    --      own skin folder doesn't exist (e.g. StockAKMN if Skins/StockAKMN/ doesn't
    --      exist but AKMN/Zenith/Textures/Stock does). For Models that DO have their
    --      own item folder (CombatGloves, WastelandShirt, etc.), if their own skin
    --      doesn't exist for this skin name, we SKIP them entirely — don't pollute
    --      them with weapon's skin.
    --   3. First match (last resort — should rarely happen).
    -- This fixes two regressions:
    --   a) CombatGloves Model was getting AKMN's Textures/Base because weapon_item
    --      was incorrectly preferred over model's own item_id.
    --   b) Receiver was getting CombatGloves' Textures/Base because first-match
    --      won when weapon_item wasn't in items list.
    local f2 = skins_folder()
    for model, items in pairs(model_to_items) do
        local chosen = nil
        -- 1. Try model_id (own item folder with this skin)
        local model_id = get_model_item_id(model)
        if model_id then
            for _, n in ipairs(items) do
                if n == model_id then chosen = n break end
            end
        end
        -- 2. Try weapon_item ONLY if Model has no own item folder in Skins/ at all.
        --    This is the key gate: CombatGloves has its own Skins/CombatGloves/ folder,
        --    so even if CombatGloves/Zenith doesn't exist, we DON'T fall back to AKMN.
        --    Only Models without any own skin folder (e.g. nested attachment Models in
        --    vm whose name isn't an ItemsList entry) get the weapon_item fallback.
        if not chosen and model_id and f2 then
            local has_own_folder = f2:FindFirstChild(model_id) ~= nil
            if not has_own_folder then
                for _, n in ipairs(items) do
                    if n == weapon_item then chosen = n break end
                end
            end
        end
        -- 3. First match (rare fallback — covers vm receiver Models that have no
        --    detectable item_id and no own folder; their items list will typically
        --    only contain weapon_item anyway)
        if not chosen then
            chosen = items[1]
        end
        pcall(cheat.dressSkin, model, chosen, skin)
    end
end

-- DEBUG (dj skinchanger investigation): one-shot dump of Camera's children + the
-- Skinnable keys present on each Model's BaseParts + whether the selected skin
-- has matching Textures/Materials. Triggers only when skin_last_vm changes.
-- Read the console output and send it back so we can wire the correct item_ids.
local skin_debug_dumped_vm = nil
local function skin_debug_dump(parent, weapon_item, skin)
    if skin_debug_dumped_vm == parent then return end  -- once per parent change
    skin_debug_dumped_vm = parent
    print("────────── [ZALUPA SKIN DEBUG] ──────────")
    print("weapon_item = " .. tostring(weapon_item) .. "  skin = " .. tostring(skin))
    if not parent then print("parent is nil"); print("────────────────────────────────────────"); return end
    local children = parent:GetChildren()
    print("parent: " .. tostring(parent:GetFullName()) .. "  (" .. #children .. " children)")
    local f = skins_folder()
    local list = items_list_skins()
    for i, m in ipairs(children) do
        if m:IsA("Model") then
            local part_item = get_model_item_id(m)
            print(string.format("  [%d] Model %q  detected_item_id=%q", i, m.Name, tostring(part_item)))
            -- Collect Skinnable keys on this Model's BaseParts
            local keys = {}
            for _, p in m:GetDescendants() do
                if p:IsA("BasePart") then
                    local k = p:GetAttribute("Skinnable")
                    if k and not keys[k] then keys[k] = (p.Name or "?") end
                end
            end
            local key_str = {}
            for k, n in pairs(keys) do table.insert(key_str, k .. "→" .. n) end
            print("       Skinnable keys: " .. (#key_str > 0 and table.concat(key_str, ", ") or "(none)"))
            -- Look up the skin folder for the detected item_id and print its Textures/Materials
            if part_item and f then
                local skin_folder = f:FindFirstChild(part_item)
                local skn = skin_folder and skin_folder:FindFirstChild(skin)
                if skn then
                    local tx = skn:FindFirstChild("Textures")
                    local mt = skn:FindFirstChild("Materials")
                    local tx_names = {}
                    if tx then for _, t in tx:GetChildren() do table.insert(tx_names, t.Name) end end
                    local mt_names = {}
                    if mt then for _, t in mt:GetChildren() do table.insert(mt_names, t.Name) end end
                    print("       Skins/" .. part_item .. "/" .. skin .. "/Textures: " .. (#tx_names > 0 and table.concat(tx_names, ", ") or "(none)"))
                    print("       Skins/" .. part_item .. "/" .. skin .. "/Materials: " .. (#mt_names > 0 and table.concat(mt_names, ", ") or "(none)"))
                else
                    print("       Skins/" .. part_item .. "/" .. tostring(skin) .. " : NOT FOUND")
                    if skin_folder then
                        local avail = {}
                        for _, s in skin_folder:GetChildren() do table.insert(avail, s.Name) end
                        print("         available skins: " .. (#avail > 0 and table.concat(avail, ", ") or "(none)"))
                    else
                        print("         no Skins/" .. part_item .. " folder at all")
                    end
                end
            end
        end
    end
    print("────────────────────────────────────────")
end

-- Filter: RangedWeapon + Melee/knife. ItemType может быть "Melee" ИЛИ "MeleeWeapon".
-- Name-based fallback: если предмет не в ItemsList или без ItemProperties, пускаем по имени.
local function skin_is_weapon_or_knife(name)
    local lower = string.lower(tostring(name))
    -- name-based: knives / melee by name
    if lower:find("knife") or lower:find("bayonet") or lower:find("machete")
       or lower:find("axe") or lower:find("melee") then
        return true
    end
    local list = items_list_skins()
    local entry = list and list:FindFirstChild(name)
    if not entry then return false end
    local props = entry:FindFirstChild("ItemProperties")
    if not props then return false end
    local itype = props:GetAttribute("ItemType")
    return itype == "RangedWeapon" or itype == "Melee" or itype == "MeleeWeapon"
end

-- List of skinnable weapon/knife items
local function skin_weapon_list()
    local f = skins_folder()
    local out = {}
    if f then
        for _, i in f:GetChildren() do
            if skin_is_weapon_or_knife(i.Name) then
                table.insert(out, i.Name)
            end
        end
    end
    table.sort(out)
    return out
end

-- Skin names for an item
local function skin_names_of(item)
    local f = skins_folder()
    local folder = f and f:FindFirstChild(item)
    local out = {}
    if folder then
        for _, s in folder:GetChildren() do
            table.insert(out, s.Name)
        end
    end
    table.sort(out)
    if #out == 0 then out = {"Default"} end
    return out
end

-- Find owned skin ObjectValues for an item
local function skin_key_of(obj)
    if typeof(obj) ~= "Instance" or not obj:IsA("ObjectValue") then return nil end
    local ref = obj.Value
    if not ref then return nil end
    local props = ref:FindFirstChild("ItemProperties")
    local special = props and props:GetAttribute("SpecialSkinItem")
    if type(special) == "string" and special ~= "" then return special end
    return ref.Name
end

local function skin_owned(item)
    local out = {}
    local seen = {}
    local player_folder = ReplicatedStorage:FindFirstChild("Players")
    local data = player_folder and player_folder:FindFirstChild(LocalPlayer.Name)
    if not data then return out end
    local valid = {[item] = true}
    local f = skins_folder()
    local skins = f and f:FindFirstChild(item)
    if skins then
        for _, s in skins:GetChildren() do
            local ms = s:GetAttribute("ModelSkin")
            if type(ms) == "string" and ms ~= "" then valid[ms] = true end
        end
    end
    local function scan(root)
        if not root then return end
        for _, v in root:GetChildren() do
            if not seen[v] and v:IsA("ObjectValue") then
                if valid[v.Name] or valid[skin_key_of(v) or ""] then
                    seen[v] = true
                    table.insert(out, v)
                end
            end
            local inner = v:FindFirstChild("Inventory")
            if inner then scan(inner) end
        end
    end
    scan(data:FindFirstChild("Inventory"))
    scan(data:FindFirstChild("Hotbar"))
    return out
end

local function skin_stamp(obj, item, skin)
    local list = items_list_skins()
    local f = skins_folder()
    local sk = f and f:FindFirstChild(item)
    local skn = sk and sk:FindFirstChild(skin)
    local model_skin = skn and skn:GetAttribute("ModelSkin")
    local target = (type(model_skin) == "string" and model_skin ~= "" and model_skin) or nil
    if not target and list and list:FindFirstChild(item) then target = item end
    if obj:GetAttribute("Skin") == skin and (not target or obj.Name == target) then return false end
    if target and obj.Name ~= target then
        obj.Name = target
        local ref = list and list:FindFirstChild(target)
        if ref then obj.Value = ref end
    end
    obj:SetAttribute("Skin", skin)
    return true
end

local function skin_apply(item, skin)
    local n = 0
    for _, obj in skin_owned(item) do
        if skin_stamp(obj, item, skin) then n = n + 1 end
    end
    -- FIX: dressSkin_recursive walks ALL BaseParts in Camera (or Tool) descendants,
    -- collects their Skinnable keys, then for each key finds the matching item folder
    -- in Skins/ and applies dressSkin. Covers receiver + all attachment parts whether
    -- they're in sibling Models, nested inside vm, or async-loaded after equip.
    dressSkin_recursive(Camera, item, skin)
    local char = LocalPlayer.Character
    if char then
        -- Tool in Character (third-person vm). Same recursive treatment.
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            dressSkin_recursive(tool, item, skin)
        end
    end
    return n
end

-- Item icon resolver
local function skin_item_icon(name)
    local list = items_list_skins()
    if not list then return "" end
    local entry = list:FindFirstChild(name)
    if entry then
        local props = entry:FindFirstChild("ItemProperties")
        if props then
            local icon = props:FindFirstChild("ItemIcon")
            if icon and icon:IsA("ImageLabel") and icon.Image ~= "" then return icon.Image end
            local attr = props:GetAttribute("ItemIcon")
            if type(attr) == "string" and attr ~= "" then return attr end
        end
    end
    -- fallback: any skin's icon
    local f = skins_folder()
    local folder = f and f:FindFirstChild(name)
    if folder then
        for _, skn in folder:GetChildren() do
            local attr = skn:GetAttribute("ItemIcon")
            if type(attr) == "string" and attr ~= "" then return attr end
            local ic = skn:FindFirstChild("ItemIcon", true)
            if ic and ic:IsA("ImageLabel") and ic.Image ~= "" then return ic.Image end
        end
    end
    return ""
end

local function skin_icon(item, skin)
    local f = skins_folder()
    local folder = f and f:FindFirstChild(item)
    local skn = folder and folder:FindFirstChild(skin)
    if skn then
        local attr = skn:GetAttribute("ItemIcon")
        if type(attr) == "string" and attr ~= "" then return attr end
        local icon = skn:FindFirstChild("ItemIcon", true)
        if icon and icon:IsA("ImageLabel") and icon.Image ~= "" then return icon.Image end
    end
    return skin_item_icon(item)
end

