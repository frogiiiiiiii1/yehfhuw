            local k = math.min(1, (now - c.phaseAt) / NC_SINK)
            target = c.start:Lerp(nc_cf_at(c, c.u), 1 - (1 - k) ^ 4)
            if k >= 1 then c.phase = 1; c.phaseAt = now end
