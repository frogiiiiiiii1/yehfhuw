        end)
        tab.MouseEnter:Connect(function() tab.BackgroundColor3 = GE_CELL_HOVER end)
        tab.MouseLeave:Connect(function() tab.BackgroundColor3 = GE_CELL end)
    end
    -- auto-select first slot
