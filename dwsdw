    -- AA + Fake Lag renderstepped (matches swim.lua exactly)
    -- Uses new_renderstepped like swim, NOT new_heartbeat.
    cheat.utility.new_renderstepped(function(delta)
        if not aa_enabled and not fake_lag_enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        if hum.Health <= 0 then return end

        hum.AutoRotate = not aa_enabled
        if aa_enabled then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

            local _, calc_yaw, _ = Camera.CFrame:ToOrientation()

            if aa_mode == "Reverse" then
                calc_yaw = calc_yaw + math.rad(180)
            elseif aa_mode == "Spin" then
                calc_yaw = calc_yaw + ((tick() * 10) % (math.pi * 2))
            elseif aa_mode == "Random" then
                calc_yaw = calc_yaw + math.rad(math.random(-120, 120))
            elseif aa_mode == "FlatRandom" then
                calc_yaw = math.rad(math.random(0, 360))
            end

