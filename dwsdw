-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 16g] DESYNC — ported from swim.lua
-- Spoofs HRP position in Heartbeat, restores in RenderStepped.
-- Uses NetworkIsSleeping + physics rate manipulation to prevent server kick.
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
    local desync_enabled = false
    local old_cframe = nil
    local old_velocity = nil
    local replicated_hrp_cframe = nil
    cheat.desync_enabled = false

    -- Anti-kick: physics rate + NetworkIsSleeping
    local desync_turned_on = false
    local desync_freeze_factor = 100
    local original_rate = nil
    local original_bandwidth = nil
    local is_sleeping = false
    local sleep_old = 0

    -- Save original physics rates
    pcall(function()
        original_rate = getfflag("S2PhysicsSenderRate")
        original_bandwidth = getfflag("PhysicsSenderMaxBandwidthBps")
    end)

    local function set_physics_rate(rate, bandwidth)
        pcall(function()
            setfflag("S2PhysicsSenderRate", tostring(rate))
            setfflag("PhysicsSenderMaxBandwidthBps", tostring(bandwidth))
        end)
    end

    -- Settings
    local desync_visualize = false
    local desync_x_offset, desync_y_offset, desync_z_offset = 0, 0, 0
    local desync_x_rotate, desync_y_rotate, desync_z_rotate = 0, 0, 0
    local desync_random_rotation, desync_random_position = false, false
    local desync_random_position_range = 5
    local desync_velocity = false
    local desync_velocity_x, desync_velocity_y, desync_velocity_z = 0, 0, 0

    -- No __index hook — it causes menu/UI to see stale positions (menu teleport bug).
    -- Desync works without it: Heartbeat spoofs → RenderStepped:Wait() → restore.
    -- NetworkIsSleeping prevents the server from seeing the spoof and kicking.

    -- Desync Heartbeat: spoof → restore → yield → re-spoof pattern
    -- This ensures camera sees the REAL position during render, not the spoof.
    -- The server still gets the spoof because networking runs between Heartbeat
    -- and RenderStepped.
    cheat.utility.track_conn(RunService.Heartbeat:Connect(function()
        replicated_hrp_cframe = nil
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")

        if not (humanoid and hrp) then return end
        if humanoid.Health <= 0 then return end
        if not desync_enabled then return end

        -- Save real position
        old_cframe = hrp.CFrame
        old_velocity = hrp.AssemblyLinearVelocity

        -- Apply spoof
        local hrp_offset = CFrame.new(
            desync_x_offset,
            desync_y_offset,
            desync_z_offset
        ) * CFrame.Angles(
            desync_x_rotate,
            desync_y_rotate,
            desync_z_rotate
        )
        if desync_random_position then
            hrp_offset = hrp_offset + (
                CFrame.Angles(
                    (math.random() - math.random()) * 2 * math.pi,
                    (math.random() - math.random()) * 2 * math.pi,
                    (math.random() - math.random()) * 2 * math.pi
                ) * CFrame.new(0, 0, -desync_random_position_range)
            ).Position
        end
        if desync_random_rotation then
            hrp_offset = hrp_offset * CFrame.Angles(
                (math.random() - math.random()) * 2 * math.pi,
                (math.random() - math.random()) * 2 * math.pi,
                (math.random() - math.random()) * 2 * math.pi
            )
        end

        replicated_hrp_cframe = old_cframe * hrp_offset
        hrp.CFrame = replicated_hrp_cframe

        if desync_velocity then
            hrp.AssemblyLinearVelocity = Vector3.new(
                desync_velocity_x,
                desync_velocity_y,
                desync_velocity_z
            )
        end

        -- Restore BEFORE render so camera sees real position
        RunService.RenderStepped:Wait()
        if not hrp or not hrp.Parent then return end

        hrp.CFrame = old_cframe
        if desync_velocity then
            hrp.AssemblyLinearVelocity = old_velocity
        end
    end))

    -- NetworkIsSleeping toggle: prevents server from seeing position changes.
    -- Toggles at rate 1/desync_freeze_factor (default 100 times per second).
    -- When sleeping, physics sender doesn't send position updates.
    cheat.utility.track_conn(RunService.Heartbeat:Connect(function()
        if not desync_turned_on then return end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = tick()
        local factor = 1 / desync_freeze_factor
        if now - sleep_old >= factor then
            sleep_old = now
            is_sleeping = not is_sleeping
            pcall(function()
                sethiddenproperty(hrp, "NetworkIsSleeping", is_sleeping)
            end)
        end
    end))

    -- Visualization: ghost clone showing spoofed position (like fake lag ghost)
    local desync_ghost = nil
    local desync_ghost_color = Color3.fromRGB(255, 80, 80)

    cheat.utility.new_renderstepped(function()
        -- Remove old ghost if not visualizing
        if not desync_visualize or not desync_enabled or not replicated_hrp_cframe then
            if desync_ghost then
                desync_ghost:Destroy()
                desync_ghost = nil
            end
            return
        end

        local character = LocalPlayer.Character
        if not character then return end

        -- Create or update ghost
        if not desync_ghost or not desync_ghost.Parent then
            local oldA = character.Archivable
            character.Archivable = true
            desync_ghost = character:Clone()
            character.Archivable = oldA
            if not desync_ghost then return end
            desync_ghost.Name = "DesyncGhost_ESP_IGNORE"
            for _, v in pairs(desync_ghost:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.ForceField
                    v.Color = desync_ghost_color
                    v.CanCollide = false
                    v.CanTouch = false
                    v.CanQuery = false
                    v.Massless = true
                    v.Anchored = true
                elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("Clothing")
                    or v:IsA("Accessory") or v:IsA("Script") or v:IsA("LocalScript")
                    or v:IsA("SurfaceAppearance") then
                    v:Destroy()
                end
            end
            local gHum = desync_ghost:FindFirstChildOfClass("Humanoid")
            if gHum then gHum:Destroy() end
            desync_ghost.Parent = workspace.Terrain
        end

        -- Move ghost to spoofed position
        desync_ghost:PivotTo(replicated_hrp_cframe)
    end)

    -- ── Combat tab: Desync section ────────────────────────────────────────
    local DSGroup = Tabs.Combat:AddRightGroupbox("Desync")
    local ds_toggle = DSGroup:AddToggle("desync_enabled", {
        Text = "Enable Desync",
        Default = false,
        Callback = function(v)
            desync_enabled = v
            cheat.desync_enabled = v
            if v then
                -- Enable anti-kick: set high physics rate, then toggle NetworkIsSleeping
                desync_turned_on = true
                set_physics_rate(32767, 32767 * 32)
            else
                -- Disable: restore physics rate
                desync_turned_on = false
                if original_rate then
                    set_physics_rate(original_rate, original_bandwidth or original_rate * 32)
                end
            end
        end
    })
    ds_toggle:AddKeyPicker("desync_key", {
        Default = "B",
        Text = "Desync Key",
        Mode = "Toggle",
        SyncToggleState = true,
    })
    DSGroup:AddSlider("desync_freeze", {
        Text = "Freeze Factor", Min = 1, Max = 200, Rounding = 0, Default = 100,
        Callback = function(v) desync_freeze_factor = v end
    })
    DSGroup:AddToggle("desync_visualize", {
        Text = "Visualize Desync",
        Default = false,
        Callback = function(v) desync_visualize = v end
    }):AddColorPicker("desync_vis_color", {
        Default = Color3.fromRGB(255, 80, 80),
        Callback = function(v)
            desync_ghost_color = v
            if desync_ghost then
                for _, part in pairs(desync_ghost:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = v
                    end
                end
            end
        end
    })
    DSGroup:AddSlider("desync_x", {
        Text = "X Offset", Min = -10, Max = 10, Rounding = 1, Default = 0,
        Callback = function(v) desync_x_offset = v end
    })
    DSGroup:AddSlider("desync_y", {
        Text = "Y Offset", Min = -10, Max = 10, Rounding = 1, Default = 0,
        Callback = function(v) desync_y_offset = v end
    })
    DSGroup:AddSlider("desync_z", {
        Text = "Z Offset", Min = -10, Max = 10, Rounding = 1, Default = 0,
        Callback = function(v) desync_z_offset = v end
    })
    DSGroup:AddSlider("desync_rx", {
        Text = "X Rotate", Min = 0, Max = 20, Rounding = 1, Default = 0,
        Callback = function(v) desync_x_rotate = math.rad(v * 18) end
    })
    DSGroup:AddSlider("desync_ry", {
        Text = "Y Rotate", Min = 0, Max = 20, Rounding = 1, Default = 0,
        Callback = function(v) desync_y_rotate = math.rad(v * 18) end
    })
    DSGroup:AddSlider("desync_rz", {
        Text = "Z Rotate", Min = 0, Max = 20, Rounding = 1, Default = 0,
        Callback = function(v) desync_z_rotate = math.rad(v * 18) end
    })
    DSGroup:AddToggle("desync_rand_rot", {
        Text = "Random Rotation",
        Default = false,
        Callback = function(v) desync_random_rotation = v end
    })
