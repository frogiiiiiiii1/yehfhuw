                if visualize_server_pos then
                    task.spawn(function()
                        local oldA = char.Archivable
                        char.Archivable = true
                        local ghost = char:Clone()
                        char.Archivable = oldA
                        if ghost then
                            ghost.Name = "FakeLagGhost_ESP_IGNORE"
                            for _, v in pairs(ghost:GetDescendants()) do
