    nc_label.TextSize = 12
    nc_label.TextStrokeTransparency = 0.35
    nc_label.TextColor3 = NC_IDLE
    nc_label.Text = ""
    nc_label.Visible = false
    nc_label.Parent = nc_gui
    local function nc_status(text, color)
