local _lpi_price_cache = {}
local function _lpi_item_price(name)
    if not name or name == "" then return 0 end
    if _lpi_price_cache[name] ~= nil then return _lpi_price_cache[name] end
    local list = ReplicatedStorage:FindFirstChild("ItemsList")
    local base = tostring(name):gsub("_unlocked$", ""):gsub("_T%d+$", "")
    local item = list and (list:FindFirstChild(name) or list:FindFirstChild(base))
    local props = item and item:FindFirstChild("ItemProperties")
    local price = props and tonumber(props:GetAttribute("Price")) or 0
    if #_lpi_price_cache < 2000 then _lpi_price_cache[name] = price end
    return price
end

-- Recursive inventory value calculator
-- Handles game structure: Inventory → containers → each may have "Inventory" subfolder → items
local function _lpi_inv_value(folder, depth)
    if not folder or depth > 6 then return 0, nil, 0 end
    local total, best_name, best_val = 0, nil, 0
    for _, child in ipairs(folder:GetChildren()) do
        -- Check if this child is an item (has Amount attribute)
        local amount = tonumber(child:GetAttribute("Amount")) or 1
        local val = _lpi_item_price(child.Name) * math.max(1, math.floor(amount))
        total = total + val
        if val > best_val then best_val, best_name = val, child.Name end
        -- Recurse into "Inventory" subfolder (containers have nested inventory)
        local nested = child:FindFirstChild("Inventory")
        if nested then
            local cv, cn, cb = _lpi_inv_value(nested, depth + 1)
            total = total + cv
            if cb > best_val then best_val, best_name = cb, cn end
        end
    end
    return total, best_name, best_val
end

local _lpi_tick = 0
cheat.utility.new_heartbeat(function()
    local now = os.clock()
    if now - _lpi_tick < 1.5 then return end
    _lpi_tick = now
    local folder = ReplicatedStorage:FindFirstChild("Players")
    local data = folder and folder:FindFirstChild(LocalPlayer.Name)
    if not data then return end
    -- ReplicatedStorage paths used by the game:
    local status = data:FindFirstChild("Status")
    local journey = status and status:FindFirstChild("Journey")
    local stats = journey and journey:FindFirstChild("Statistics")
    local uac = status and status:FindFirstChild("UAC")
    -- Reports
    local rep_folder = uac and uac:FindFirstChild("Reports")
    local total_reps = 0
    if rep_folder then
        local attr1 = rep_folder:GetAttribute("1")
        if typeof(attr1) == "number" then
            total_reps = attr1
        else
            for _, count in pairs(rep_folder:GetAttributes()) do
                if typeof(count) == "number" then total_reps = total_reps + count end
            end
        end
    end
    -- K/D
    local kills = stats and (stats:GetAttribute("K_PVP") or stats:GetAttribute("Kills")) or 0
    local deaths = stats and (stats:GetAttribute("D_PVP") or stats:GetAttribute("Deaths")) or 0
    -- Play time
    local hours = stats and stats:GetAttribute("TimePlayed") or 0
    -- Loot value — scan inventory + hotbar recursively
    local inv = data:FindFirstChild("Inventory")
    local hotbar = data:FindFirstChild("Hotbar")
    local loot_val, top_name = 0, nil
    if inv then
        local v, n, _ = _lpi_inv_value(inv, 0)
        loot_val = loot_val + v
        if n then top_name = n end
    end
    if hotbar then
        local v, n, _ = _lpi_inv_value(hotbar, 0)
        loot_val = loot_val + v
        if n and (not top_name or v > (_lpi_item_price(top_name) or 0)) then top_name = n end
    end
    local player_count = #Players:GetPlayers()
    -- FIX #1: Label requires :SetText() — direct .Text= does not update UI
    pcall(function() if _lpi_labels.reports   then _lpi_labels.reports:SetText("Reports: " .. tostring(total_reps)) end end)
    pcall(function() if _lpi_labels.kd         then _lpi_labels.kd:SetText("K/D: " .. tostring(kills) .. "/" .. tostring(deaths)) end end)
    pcall(function() if _lpi_labels.loot       then _lpi_labels.loot:SetText("Loot value: $" .. tostring(loot_val)) end end)
    pcall(function() if _lpi_labels.topitem     then _lpi_labels.topitem:SetText("Top item: " .. (top_name or "-") .. " ($" .. tostring(_lpi_item_price(top_name or "")) .. ")") end end)
    pcall(function() if _lpi_labels.players     then _lpi_labels.players:SetText("Players in raid: " .. tostring(player_count)) end end)
    pcall(function() if _lpi_labels.time        then _lpi_labels.time:SetText("Play time: " .. math.floor((hours or 0) / 3600) .. "h") end end)
end)

