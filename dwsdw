-- Auto-apply: dress viewmodel when it changes + periodic re-stamp owned items
-- Must try both vm.Item.Name AND vm.Name as the lookup key —
-- The vm structure varies (some vms have an Item child whose Name is the
-- weapon id; some don't, and the vm's own Name is the weapon id). Without the fallback
-- auto-apply silently no-ops on vms that lack a matching Item child.
-- FIX: dress ALL Models in Camera so composite weapons (AKMN/M4/FAL with separate
-- stock/front/handle/magazine Models) get skinned on every part, not just the receiver.
--
-- FIX (dj regression "skin пропадает после убирания/доставания"):
-- The game spawns the vm Model first, then loads Stock/Front/Handle/Magazine
-- Models into Camera asynchronously over the next few frames. Our old cache checked
-- only `vm ~= skin_last_vm` — when the vm instance stayed the same but new attachment
-- Models appeared, we skipped re-applying. Result: receiver skinned, attachments bare.
-- Fix: track a fingerprint of Camera's Model child names. When it changes (new Models
-- loaded, or vm despawned for re-equip), re-run dressSkin_all_models. dressSkin is
-- idempotent (destroys old SurfaceAppearance + re-clones), so re-applying on already-
-- skinned parts during the brief loading window is safe.
--
-- FIX (dj regression "скин с ручки/ствола/приклада/магазина пропадает после holster"):
-- The weapon Model lives in BOTH Camera (first-person vm) AND Character (world model,
-- visible in third-person and to other players). Dump showed Character.sheltercheek.AKMN
-- has its own Skinnable BaseParts (FrontMeshPart2). Our heartbeat only dressed Camera,
-- so Character's weapon Model never got re-skinned after holster/equip. Now we dress
-- BOTH Camera and Character on every fingerprint change.
local skin_last_vm = nil
local skin_last_fingerprint = ""
cheat.utility.new_heartbeat(function()
    if not skin_auto_apply then return end
    local vm = Camera and Camera:FindFirstChildOfClass("Model")
    local char = LocalPlayer.Character

    -- Determine weapon item_id: try vm.Item.Name, vm.Name, then scan Character for
    -- a Model whose Name matches a skin_choice entry (covers third-person case where
    -- vm doesn't exist but Character has the weapon Model directly).
    local name = nil
    if vm then
        local it = vm:FindFirstChild("Item")
        name = (it and skin_choices[it.Name] and it.Name) or (skin_choices[vm.Name] and vm.Name)
    end
    if not name and char then
        for _, m in ipairs(char:GetChildren()) do
            if m:IsA("Model") and skin_choices[m.Name] then
                name = m.Name
                break
            end
        end
    end

    -- No weapon equipped at all (no vm, no Character weapon Model) — reset cache.
    if not vm and not name then
        if skin_last_vm then
            skin_last_vm = nil
            skin_last_fingerprint = ""
        end
        return
    end

    -- Build fingerprint: vm identity + sorted Camera Model names + Character weapon Model name.
    -- Catches: vm replacement, async attachment loading, holster/equip cycle on Character.
    local cam_names = {}
    if Camera then
        for _, m in ipairs(Camera:GetChildren()) do
            if m:IsA("Model") then table.insert(cam_names, m.Name) end
        end
    end
    table.sort(cam_names)
    local char_weapon = (char and name) or ""
    local fp = tostring(vm) .. "|" .. table.concat(cam_names, ",") .. "|" .. char_weapon
    if fp == skin_last_fingerprint then return end
    skin_last_fingerprint = fp
    skin_last_vm = vm

    if name then
        -- Dress BOTH Camera (first-person vm) AND Character (world model visible to others).
        -- dressSkin_recursive walks GetDescendants so it covers nested parts and sibling
        -- Models in either container. dressSkin is idempotent so re-applying is safe.
        dressSkin_recursive(Camera, name, skin_choices[name])
        if char then
            dressSkin_recursive(char, name, skin_choices[name])
        end
    end
end)

local skin_attr_tick = 0
cheat.utility.new_heartbeat(function()
    if not skin_auto_apply or os.clock() - skin_attr_tick < 2 then return end
    skin_attr_tick = os.clock()
    for item, skin in pairs(skin_choices) do
        local owned = skin_owned(item)
        if #owned > 0 then
            local need = false
            for _, obj in ipairs(owned) do
                if obj:GetAttribute("Skin") ~= skin then need = true break end
            end
            if need then pcall(skin_apply, item, skin) end
        end
    end
end)

