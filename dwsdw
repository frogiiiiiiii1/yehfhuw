-- ─── CUSTOM STATE PERSISTENCE (skins + friends) ────────────────────────────
-- Obsidian SaveManager only handles Library.Flags (toggle/slider values).
-- Skins choices and friends list are stored separately as JSON files in the
-- same ZalupaHooK folder so they survive script restarts and config loads.
local SKINS_FILE = "ZalupaHooK/skins.json"
local FRIENDS_FILE = "ZalupaHooK/friends.json"

local function _load_json(path)
    if not readfile then return nil end
    local ok, content = pcall(readfile, path)
    if not ok or type(content) ~= "string" or content == "" then return nil end
    local ok_parse, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(content)
    end)
    if ok_parse and type(data) == "table" then return data end
    return nil
end

local function _save_json(path, data)
    if not writefile then return false end
    local ok, json_str = pcall(function()
        return game:GetService("HttpService"):JSONEncode(data)
    end)
    if not ok or type(json_str) ~= "string" then return false end
    pcall(writefile, path, json_str)
    return true
end

-- Hook SaveManager.Save (manual "Save config" button) and SaveManager.Load (manual "Load config"
-- button AND called by LoadAutoloadConfig) so custom state is preserved across all
-- config save/load cycles.
local _orig_Save = SaveManager.Save
SaveManager.Save = function(self, name, ...)
    local res = _orig_Save(self, name, ...)
    -- Auto-save skins+friends alongside the regular config save
    pcall(function()
        _save_json(SKINS_FILE, cheat.skin_choices or {})
        local friends_list = {}
        for fname, _ in pairs(cheat.friends or {}) do table.insert(friends_list, fname) end
        table.sort(friends_list)
        _save_json(FRIENDS_FILE, friends_list)
    end)
    return res
end

local _orig_Load = SaveManager.Load
SaveManager.Load = function(self, name, ...)
    local res = _orig_Load(self, name, ...)
