-- [BLOCK 15b] __namecall HOOK — Silent Aim + Instant Hit
-- ═══════════════════════════════════════════════════════════════════════════
local __namecall
__namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if checkcaller() then return __namecall(self, ...) end

    if method ~= "GetAttribute" and method ~= "Raycast"
        and method ~= "InvokeServer" and method ~= "invokeServer"
        and method ~= "FireServer" and method ~= "fireServer" then
        return __namecall(self, ...)
    end

    local args = {...}
    local argc = select("#", ...)

    -- ANTI DROWN: блокируем FireServer на Drowning-ремоут (объединено из отдельного хука)
    if anti_drown and (method == "FireServer" or method == "fireServer") and self.Name == "Drowning" then
        return nil
    end

    if method == "GetAttribute" then
        local attribute = args[1]
        if silent_aim.nospread and attribute == "AccuracyDeviation" then return 0 end
        if silent_aim.enabled then
            if attribute == "ProjectileDrop" then return 0 end
            if attribute == "Drag" then return 0 end
        end
    end

    -- RAYCAST: substitute result with hit in target_part (silent aim)
    -- Only intercept raycasts from the Bullet module to avoid breaking ESP vis-checks.
    if method == "Raycast" then
        local origin = args[1]
        -- Check if this raycast comes from the Bullet module (stack-based check)
        local from_bullet = false
        if debug and debug.traceback then
            pcall(function()
                from_bullet = debug.traceback():find("Bullet") ~= nil
            end)
        end
        if typeof(origin) == "Vector3" and silent_aim.enabled and silent_aim.target_part and from_bullet then
            local hitpart = silent_aim.target_part
            if hitpart and hitpart.Parent then
                -- corner_shoot/manipulation: shift origin
                if silent_aim.corner_shoot and silent_aim.manipulated_origin then
                    origin = silent_aim.manipulated_origin
                    args[1] = origin
                end
                -- Force-collision gated by wallbang OR isvisible OR manipulated
                local can_force_collision = silent_aim.testwallbang
                    or silent_aim.isvisible
                    or silent_aim.manipulated_origin ~= nil
                if can_force_collision then
                    local direction = hitpart.Position - origin
                    return {
                        Instance = hitpart,
                        Position = hitpart.Position,
                        Normal   = direction.Unit * -1,
                        Material = hitpart.Material,
                        Distance = direction.Magnitude
                    }
                end
                -- wallbang OFF + target not visible: redirect bullet ray direction toward target,
                -- let the raycast run normally (walls will block the shot)
                args[2] = hitpart.Position - origin
                setnamecallmethod(method)
                return __namecall(self, unpack(args, 1, argc))
            end
        end
    end

    -- FIREPROJECTILE: silent aim direction + instant hit timestamp
    if (method == "InvokeServer" or method == "invokeServer") and self.Name == "FireProjectile" then
        silent_aim._exact_fire_tick = tick()
        local origin = Workspace.CurrentCamera.CFrame.Position
        local tp = silent_aim.enabled and silent_aim.target_part
        local is_empty = false
        pcall(function()
            local wpn = get_gun(LocalPlayer)
            if wpn == "None" then return end
            local pi = ReplicatedPlayers:FindFirstChild(LocalPlayer.Name) and ReplicatedPlayers[LocalPlayer.Name]:FindFirstChild("Inventory")
            local iw = pi and pi:FindFirstChild(wpn)
            if not (iw and iw:FindFirstChild("Attachments")) then return end
            local mag = iw.Attachments:FindFirstChild("Magazine")
            if not mag then return end
            local sv = mag:FindFirstChildOfClass("StringValue")
            local ip = sv and sv:FindFirstChild("ItemProperties")
            local la = ip and ip:FindFirstChild("LoadedAmmo")
            if la and la:IsA("Folder") and #la:GetChildren() <= 0 then is_empty = true end
        end)
        if not is_empty and tp and tp.Parent then
            if silent_aim.corner_shoot and silent_aim.manipulated_origin then
                origin = silent_aim.manipulated_origin
                args[1] = (tp.Position - origin).Unit
            end
            -- INSTANT HIT: подмена timestamp чтобы пуля прилетела мгновенно
            if silent_aim.instant and args[3] then
                args[3] = tick() - ((tp.Position - origin).Magnitude / 1000)
            end
            -- FIX: связываем hit effects на legit-выстрелы (не от cheat-кода)
            pcall(cheat.fire_hit_effects, tp)
        end
        -- UG Resolver fix: while HRP is pinned underground, override bullet
        -- direction to point from camera (above ground) toward args[1] target.
        -- Without this, the server uses HRP position (underground) as bullet
        -- origin → bullet hits ground/terrain → misses target.
        if cheat.ug_resolver_holding then
            -- args[1] is the direction Vector3 sent to server. Re-derive it
            -- from camera position toward the original target direction endpoint.
            -- args[1] is a Unit vector; we keep its direction but the server
            -- should compute the trajectory from Camera, not HRP.
            -- The server's FireProjectile handler reads the player's character
            -- position for trajectory. Since HRP is underground, we need to
            -- shift the direction so the trajectory clears the ground.
            -- Easiest fix: make args[1] point slightly upward so the bullet
            -- arcs over the ground between camera and target.
            local cur_dir = args[1]
            if typeof(cur_dir) == "Vector3" then
                -- Add upward bias so bullet doesn't immediately hit ground
                args[1] = (cur_dir + Vector3.new(0, 0.05, 0)).Unit
            end
        end
        setnamecallmethod(method)
        return __namecall(self, unpack(args, 1, argc))
    end

    setnamecallmethod(method)
    return __namecall(self, unpack(args, 1, argc))
end))
cheat._namecall_old = __namecall

