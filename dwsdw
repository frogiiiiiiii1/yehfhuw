local function populateInvData(target)
    if not target or target.Name == LocalPlayer.Name then return end
    local itemsList = getInvItemsList()
    if not itemsList then return end
    if invCache.lastTargetInventory == target and invCache.lastFullInventory == invcheck.fullInventory then return end
    invCache.lastTargetInventory = target
    invCache.lastFullInventory = invcheck.fullInventory
    local inventory = getInvContainer(target)
    if not inventory then return end
    -- Clear main slots (item icons + attachment icons)
    for i = 1, 12 do
        mainSlots[i].Item.Image = EMPTY_ICON
        if mainSlots[i].Attach then
            for j = 1, 4 do mainSlots[i].Attach[j].Image = EMPTY_ICON end
        end
    end
    -- Clear full inventory grid
    for i = 1, 54 do
        fullSlots[i].Image = EMPTY_ICON
        fullCounts[i].Text = ""
    end
    -- Populate weapons (slots 1-3, with attachments)
    -- Populate clothing/armor/helmet (slots 4-12)
    local weaponIdx = 1
    local clothingIdx = 4
    for _, item in pairs(inventory:GetChildren()) do
        local slot = item:GetAttribute("Slot")
        if slot and slot:find("Clothing") then
            local itemDef = itemsList:FindFirstChild(item.Name)
            local icon = itemDef and itemDef:FindFirstChild("ItemProperties") and itemDef.ItemProperties:FindFirstChild("ItemIcon")
            if icon and clothingIdx <= 12 then
                mainSlots[clothingIdx].Item.Image = icon.Image
                clothingIdx = clothingIdx + 1
            end
        elseif item:FindFirstChild("Attachments") then
            local itemDef = itemsList:FindFirstChild(item.Name)
            local icon = itemDef and itemDef:FindFirstChild("ItemProperties") and itemDef.ItemProperties:FindFirstChild("ItemIcon")
            if icon and weaponIdx <= 3 then
                mainSlots[weaponIdx].Item.Image = icon.Image
                for _, att in pairs(item.Attachments:GetChildren()) do
                    local attSlot = att:GetAttribute("Slot")
                    local attDef = itemsList:FindFirstChild(att.Name)
                    local idx
                    if attSlot == "Magazine" then idx = 1
                    elseif attSlot == "Sight" then idx = 2
                    elseif attSlot == "Muzzle" then idx = 3
                    elseif attSlot == "Extra" then idx = 4 end
                    if idx and attDef then
                        local aicon = attDef:FindFirstChild("ItemProperties") and attDef.ItemProperties:FindFirstChild("ItemIcon")
                        if aicon then mainSlots[weaponIdx].Attach[idx].Image = aicon.Image end
                    end
                end
                weaponIdx = weaponIdx + 1
            end
        end
    end
    -- Populate full inventory grid (backpack contents)
    if invcheck.fullInventory then
        local idx = 1
        for _, container in pairs(inventory:GetChildren()) do
            local inner = container:FindFirstChild("Inventory")
            if inner and container.Name ~= "KeyChain" then
                for _, item in pairs(inner:GetChildren()) do
                    if idx > 54 then break end
                    local itemDef = itemsList:FindFirstChild(item.Name)
                    local icon = itemDef and itemDef:FindFirstChild("ItemProperties") and itemDef.ItemProperties:FindFirstChild("ItemIcon")
                    if icon then
                        fullSlots[idx].Image = icon.Image
                        local amount = item:GetAttribute("Amount") or 1
                        if amount >= 1000 then amount = math.floor(amount / 1000) .. "K"
                        else amount = "x" .. amount end
                        fullCounts[idx].Text = amount
                        idx = idx + 1
                    end
                end
            end
        end
    end
end

local function getInvValue(target)
    if invCache.lastTargetValueName == target then return invCache.lastTargetValue end
    local itemsList = getInvItemsList()
    if not itemsList then return 0 end
    local inventory = getInvContainer(target)
    local total = 0
    if inventory then
        for _, slot in pairs(inventory:GetChildren()) do
            local slotName = slot:GetAttribute("Slot")
            if slotName and slotName:find("Clothing") and slot:FindFirstChild("Inventory") then
                for _, item in pairs(slot.Inventory:GetChildren()) do
                    local itemDef = itemsList:FindFirstChild(item.Name)
                    if itemDef and itemDef:FindFirstChild("ItemProperties") then
                        if item.Name ~= "Rubles" then
                            local price = itemDef.ItemProperties:GetAttribute("Price") or 1
                            if price >= 10 then
                                local itemType = itemDef.ItemProperties:GetAttribute("ItemType")
                                if itemType == "Extra" then price = price * 0.4
                                elseif itemType == "Ammo" then price = price * (item:GetAttribute("Amount") or 1) * 0.7
                                elseif itemType == "Clothing" then price = price * 0.35
                                elseif itemType == "Medical" then price = price * 0.75
                                elseif itemType == "Barter" then price = price * 0.4 end
                            end
                            total = total + price
                        else
                            total = total + (item:GetAttribute("Amount") or 1)
                        end
                    end
                end
            end
        end
    end
    invCache.lastTargetValueName = target
    invCache.lastTargetValue = math.floor(total)
    return math.floor(total)
end

local function getInvTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, 1000
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and pos.Z > 0 then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < bestDist then bestDist = d; best = plr end
                end
            end
        end
    end
    if invcheck.showCorpse then
        local dropped = Workspace:FindFirstChild("DroppedItems")
        if dropped then
            for _, corpse in ipairs(dropped:GetChildren()) do
                if corpse:FindFirstChild("Humanoid") and corpse:FindFirstChild("Head")
                   and corpse.Name ~= LocalPlayer.Name and not corpse:FindFirstChild("AttackedBy") then
                    local pos, onScreen = Camera:WorldToViewportPoint(corpse.Head.Position)
                    if onScreen and pos.Z > 0 then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < bestDist then bestDist = d; best = corpse end
                    end
                end
            end
        end
    end
    return best
end

local _inv_acc = 0
local _inv_was_visible = false
