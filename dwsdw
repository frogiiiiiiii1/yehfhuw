-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 16b] REAL_CFRAME FOUNDATION — __index hook for HRP.CFrame/Position
-- Saves real HRP position before spoofing (Anti-Aim / Fake Lag). The __index
-- hook returns real_CFrame for HRP reads so external systems (game anticheat,
-- networking) see the real position while the player visually appears elsewhere.
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
    cheat.real_CFrame           = nil
    cheat.is_dead_or_respawning  = false
    cheat.last_fly_or_tp_time    = 0

    -- Track fly/TP state so we know when to suppress real_CFrame (during fly/tp
    -- the HRP CFrame is the player's actual intended position — no spoofing).
    -- Note: flyhack is a file-scoped local from BLOCK 12; we read it via upvalue.
    cheat.is_flying_or_tp = function()
        local fly_active = flyhack == true  -- upvalue from BLOCK 12
        if fly_active then
            cheat.last_fly_or_tp_time = tick()
            cheat.real_CFrame = nil
            return true
        elseif cheat.last_fly_or_tp_time > 0 and (tick() - cheat.last_fly_or_tp_time < 1.2) then
            cheat.real_CFrame = nil
            return true
        end
        return false
    end

    -- Track character death/respawn
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health <= 0 then
        cheat.is_dead_or_respawning = true
    end
    cheat.utility.track_conn(LocalPlayer.CharacterAdded:Connect(function()
        cheat.is_dead_or_respawning = true
        task.delay(0.6, function() cheat.is_dead_or_respawning = false end)
    end))

    -- NOTE: No __index hook and no renderstep restore.
    -- Anti-Aim only changes YAW (preserves position), like swim.lua does.
    -- This means there's no position spoof to restore, and no need for a
    -- real_CFrame hook. The server sees the modified yaw directly.
end)()

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 16c] ANTI-AIM + FAKE LAG + UG RESOLVER + RESOLVE DESYNC
-- Mirrors TOMBOU's Anti-Aim system. Uses real_CFrame from BLOCK 16b.
-- Modes: Reverse / Spin / Random / FlatRandom / None
-- Fake Lag: snapshots HRP at intervals, holds HRP at last snapshot
-- UG Resolver: hold X to pin HRP underground
-- Resolve Desync: snaps OTHER players to their LastVerifiedPos
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
