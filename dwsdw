-- [BLOCK 09e] HIT EFFECTS DISPATCHER — связывает damage numbers / hit ghost / hit sound / sparkles
-- Вызывается из shoot_weapon_packet (auto-shoot) и из __namecall FireProjectile (legit shots)
-- ═══════════════════════════════════════════════════════════════════════════
function cheat.fire_hit_effects(target_part)
    if not (typeof(target_part) == "Instance" and target_part:IsA("BasePart") and target_part.Parent) then return end
    local character = target_part.Parent
    local humanoid  = character:FindFirstChildOfClass("Humanoid")
    local hit_pos   = target_part.Position

    -- DAMAGE NUMBERS: ловим дельту здоровья через короткую задержку
    if damage_numbers_enabled and humanoid and humanoid.Parent then
        local pre_hp = humanoid.Health
        task.spawn(function()
            task.wait(0.06)
            if humanoid and humanoid.Parent then
                local dmg = pre_hp - humanoid.Health
                if dmg > 0 then spawn_damage_number(hit_pos, dmg) end
            end
        end)
    end

    -- HIT GHOST: только на килл (health → 0 в окне после выстрела)
    if hitghost_enabled and humanoid and humanoid.Parent then
        local pre_hp = humanoid.Health
        task.spawn(function()
            task.wait(0.12)
            if humanoid and humanoid.Parent and humanoid.Health <= 0 and pre_hp > 0 then
                spawn_hit_ghost(character)
            end
        end)
    end

    -- HIT SOUND
    if snd_cfg.hs_enabled then
        task.spawn(function()
            local s = Instance.new("Sound")
            s.SoundId = snd_cfg.hs_id
            s.Volume  = snd_cfg.hs_vol
            if snd_cfg.hs_id == MOAN_ID then
                s.TimePosition = 2
                task.delay(0.9, function() if s and s.Parent then s:Stop() end end)
            end
            s.Parent = game:GetService("SoundService")
            s:Play()
            game:GetService("Debris"):AddItem(s, 5)
        end)
    end

    -- HIT EFFECT (sparkles)
    if hit_effect_enabled then
        spawn_hit_effect(hit_pos)
    end
end

