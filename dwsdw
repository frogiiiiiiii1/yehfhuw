-- [BLOCK 16f] FOV GLOW — 20 circles around the FOV circle for visual glow
-- Renders 10 outer + 10 inner circles when FOV circle is shown, animated by intensity.
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
    local fov_glow_intensity = 1
    local fov_glow_circles = {}
    for i = 1, 20 do
        local c = Drawing.new("Circle")
        c.Thickness = 1
        c.NumSides = 60
        c.Filled = false
        c.Visible = false
        c.Transparency = 0.5
        c.ZIndex = 1
        cheat.drawings[c] = c
        fov_glow_circles[i] = c
    end

    -- Visuals tab: FOV Glow toggle + slider
    local fov_glow_toggle = ItemFinderGroup:AddToggle("fov_glow", {
        Text = "FOV Outline Glow",
        Default = false,
        Callback = function() end  -- checked at runtime below
    })
    ItemFinderGroup:AddSlider("fov_glow_int", {
        Text = "FOV Glow Intensity",
        Min = 1, Max = 100, Rounding = 0, Default = 10,
        Callback = function(v) fov_glow_intensity = v / 10 end
    })

    -- Renderstep: position glow circles around FOV circle
    local _was_visible = false
    cheat.utility.new_renderstepped(function()
        local glow_on = fov_glow_toggle and fov_glow_toggle.Value
        local fov_active = silent_aim.fov and silent_aim.fov_show
        if not (glow_on and fov_active) then
            if _was_visible then
                for i = 1, 20 do fov_glow_circles[i].Visible = false end
                _was_visible = false
            end
            return
        end
        _was_visible = true
        local pos = Vector2.new(Mouse.X, Mouse.Y + GuiInset.Y)
        local intensity = fov_glow_intensity
        local th = 1 + (intensity * 0.5)
        for i = 1, 10 do
            -- outer rings
            local oc = fov_glow_circles[i]
            oc.Position = pos
            oc.Radius = silent_aim.fov_size + (i * (intensity * 0.5))
            oc.Color = silent_aim.fov_color or silent_aim.tracer_color or Color3.new(1, 1, 1)
            oc.Transparency = 0.2 - (i * 0.02)
            oc.Thickness = th
            oc.Visible = true
            -- inner rings
            local ic = fov_glow_circles[i + 10]
            ic.Position = pos
            ic.Radius = math.max(0, silent_aim.fov_size - (i * (intensity * 0.5)))
            ic.Color = silent_aim.fov_color or Color3.new(1, 1, 1)
            ic.Transparency = 0.2 - (i * 0.02)
            ic.Thickness = th
            ic.Visible = true
        end
    end)
end)()

