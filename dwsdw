    -- Static box: fixed world-space dimensions (2 studs wide, 5.5 studs tall for a standing player)
    local _static_box_result = {}
    local _STATIC_W = 2.0
    local _STATIC_H_TOP = 2.8
    local _STATIC_H_BOT = 2.7
    local function calculateStaticBox(root_position)
        local root = root_position
        local cam_cf = camera.CFrame
        local right = cam_cf.RightVector
        local top_center    = root + Vector3.new(0, _STATIC_H_TOP, 0)
        local bottom_center = root - Vector3.new(0, _STATIC_H_BOT, 0)
        local top_left_s     = camera:WorldToViewportPoint(top_center    - right * _STATIC_W)
        local top_right_s    = camera:WorldToViewportPoint(top_center    + right * _STATIC_W)
        local bottom_left_s  = camera:WorldToViewportPoint(bottom_center - right * _STATIC_W)
        local bottom_right_s = camera:WorldToViewportPoint(bottom_center + right * _STATIC_W)
        local minx = math.min(top_left_s.X, bottom_left_s.X)
        local maxx = math.max(top_right_s.X, bottom_right_s.X)
        local miny = math.min(top_left_s.Y, top_right_s.Y)
        local maxy = math.max(bottom_left_s.Y, bottom_right_s.Y)
        minx, miny = math.floor(minx), math.floor(miny)
        maxx, maxy = math.floor(maxx), math.floor(maxy)
        _static_box_result.topLeft     = Vector2.new(minx, miny)
        _static_box_result.topRight    = Vector2.new(maxx, miny)
        _static_box_result.bottomLeft  = Vector2.new(minx, maxy)
        _static_box_result.bottomRight = Vector2.new(maxx, maxy)
        return _static_box_result
    end

