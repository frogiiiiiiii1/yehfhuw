            end
            return
        end

        local ug_key = get_ug_key()
        local should_hold = ug_key and UserInputService:IsKeyDown(ug_key) or false

        if should_hold and not ug_resolver_holding then
            -- Key pressed — start UG
            local hrp2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            ug_resolver_entry_cf = hrp2 and hrp2.CFrame or nil
            ug_resolver_holding = true
            cheat.ug_resolver_holding = true
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
