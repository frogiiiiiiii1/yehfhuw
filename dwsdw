-- Grid builder for ScrollingFrame
local function build_grid(scroll_frame, entries, on_select)
    for _, c in scroll_frame:GetChildren() do
        if c.Name == "GridCell" then pcall(function() c:Destroy() end) end
    end
    local layout = scroll_frame:FindFirstChild("IconGridLayout")
    if not layout then
        layout = Instance.new("UIGridLayout")
        layout.Name = "IconGridLayout"
        layout.CellSize = UDim2.fromOffset(78, 88)
        layout.CellPadding = UDim2.fromOffset(6, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Parent = scroll_frame
    end
    local pad = scroll_frame:FindFirstChild("IconGridPad")
    if not pad then
        pad = Instance.new("UIPadding")
        pad.Name = "IconGridPad"
        pad.PaddingTop = UDim.new(0, 4)
        pad.PaddingBottom = UDim.new(0, 4)
        pad.PaddingLeft = UDim.new(0, 4)
        pad.PaddingRight = UDim.new(0, 4)
        pad.Parent = scroll_frame
    end
    local buttons = {}
    for idx, entry in ipairs(entries) do
        local cell = Instance.new("TextButton")
        cell.Name = "GridCell"
        cell.LayoutOrder = idx
        cell.BackgroundColor3 = SKIN_CELL
        cell.BorderSizePixel = 0
        cell.Text = ""
        cell.AutoButtonColor = false
        cell.Parent = scroll_frame

        local icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Image = entry.icon or ""
        icon.Size = UDim2.new(1, -10, 1, -28)
        icon.Position = UDim2.new(0, 5, 0, 5)
        icon.ScaleType = Enum.ScaleType.Fit
        icon.Parent = cell

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, -4, 0, 16)
        label.Position = UDim2.new(0, 2, 1, -18)
        label.Font = Enum.Font.Gotham
        label.TextSize = 10
        label.TextColor3 = SKIN_TEXT
        label.TextStrokeTransparency = 0.5
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Text = entry.name
        label.Parent = cell

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = SKIN_BORDER
        stroke.Parent = cell

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = cell

        buttons[entry.name] = { cell = cell, stroke = stroke }
        cell.MouseButton1Click:Connect(function()
            on_select(entry.name)
        end)
        cell.MouseEnter:Connect(function() cell.BackgroundColor3 = SKIN_CELL_HOVER end)
        cell.MouseLeave:Connect(function() cell.BackgroundColor3 = SKIN_CELL end)
    end
    return buttons
end

local function highlight_buttons(buttons_map, name)
    for n, b in pairs(buttons_map) do
        b.stroke.Color = (n == name) and SKIN_ACCENT or SKIN_BORDER
        b.stroke.Thickness = (n == name) and 2 or 1
    end
end

