-- [BLOCK 21] VIEWMODEL CHAMS (arm/gun chams — extends ViewmodelGroup)
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
    local ChamsGroup = Tabs.Visuals:AddLeftGroupbox(L("grp_viewmodel_chams"))
    local cached_vm = Camera:FindFirstChildOfClass("Model")
    local last_vm_item = nil
    local last_vm_update = 0
    local is_chamming = false
    -- FIX: state vars set by callbacks — Library.Flags для colorpicker'а хранит
    -- Color3 напрямую, не {Color, Alpha} таблицу. Используем локалы.
    local vm_gun_enabled, vm_gun_color, vm_gun_mat = false, Color3.new(1,1,1), "SmoothPlastic"
    local vm_arm_enabled, vm_arm_color, vm_arm_mat = false, Color3.new(1,1,1), "SmoothPlastic"

    local function vmchams(force)
        if is_chamming then return end
        local vm = cached_vm; if not vm then return end
        local ItemView = vm:FindFirstChild("Item")
        if not force and ItemView == last_vm_item and tick() - last_vm_update < 0.5 then return end
