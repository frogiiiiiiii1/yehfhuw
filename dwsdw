    local function getBoundingBox(parts)
        local minX, minY, minZ = 1e9, 1e9, 1e9
        local maxX, maxY, maxZ = -1e9, -1e9, -1e9
        for i=1,#parts do
            local part = parts[i]
            local cf, sz = part.CFrame, part.Size
            local p1 = (cf - sz*0.5).Position
            local p2 = (cf + sz*0.5).Position
            minX = math.min(minX, p1.X, p2.X); minY = math.min(minY, p1.Y, p2.Y); minZ = math.min(minZ, p1.Z, p2.Z)
            maxX = math.max(maxX, p1.X, p2.X); maxY = math.max(maxY, p1.Y, p2.Y); maxZ = math.max(maxZ, p1.Z, p2.Z)
        end
        local min = Vector3.new(minX, minY, minZ)
        local max = Vector3.new(maxX, maxY, maxZ)
        local center = (min + max) * 0.5
        return CFrame.new(center, Vector3.new(center.X, center.Y, max.Z)), max - min
    end

    local function worldToScreen(world)
        local s, ib = camera:WorldToViewportPoint(world)
        return Vector2.new(s.X, s.Y), ib, s.Z
