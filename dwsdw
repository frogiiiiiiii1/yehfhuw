                repeat s += task.wait() until s > 1 or (mag and oldparent and mag.Parent and mag.Parent ~= oldparent)
                if s > 1 then return end
                if update_fps then pcall(function() update_fps(fps_object) end) end
            end)
            inventorymove_remote:FireServer(mag:GetAttribute("Slot") or mag:GetAttribute("SlotType"), "Magazine", mag.Parent, equipped_item.Attachments, nil)
            equip_remote:FireServer(equipped_item, equip_id)
        end)

        new_hook(fps_reloadtypes.loadByHand, function(old, fps_object, arg_ammo)
            if not instant_reload then return old(fps_object, arg_ammo) end
            local ammo, ammo_amount = get_compatible_ammo(fps_object, arg_ammo)
