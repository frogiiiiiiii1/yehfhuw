-- FIX #3: полный unload — чистит хуки, drawing'и, коннекты, GUI, parts, lighting,
-- ресторит __namecall. Вызывается re-exec гардом (BLOCK 00) перед новым запуском.
cheat.unload = function()
    if cheat._dead then return end
    cheat._dead = true
    cheat.alive = false

    -- 1. Отключаем все raw-коннекты (диспетчер, noclip, freecam, chams renderstep, events).
    pcall(function()
        for _, c in ipairs(cheat.raw_conns) do
            pcall(function() c:Disconnect() end)
        end
    end)
    pcall(function() RunService:UnbindFromRenderStep("ZalupaChamsRS") end)
    -- Unbind new renderstep hooks (Anti-Aim restore, UG Resolver).
    pcall(function() RunService:UnbindFromRenderStep("ZalupaRealCFrameRestore") end)
    pcall(function() RunService:UnbindFromRenderStep("UGResolverRS") end)

    -- 2. Гасим диспетчерские таблицы — оставшиеся new_heartbeat/new_renderstepped больше не зовутся.
    cheat.connections.heartbeats = {}
    cheat.connections.renderstepped = {}

    -- 3. ESP library (disconnect + remove drawing'и игроков/корпсов).
    pcall(function() cheat.EspLibrary.unload() end)

    -- 4. Удаляем все Drawing'и (ESP, crosshair, charge, finder, fovCircle, inventory viewer).
    pcall(function()
        for d in pairs(cheat.drawings) do
            pcall(function() d:Remove() end)
        end
    end)
    cheat.drawings = {}

    -- 5. Ресторим hookfunction-хуки (recoil/update/updateClient/melee/reload/CreateBullet/remove_bullet).
    pcall(function()
        for _, h in ipairs(cheat.hooks) do
            pcall(hookfunction, h.func, h.old)
        end
    end)
    cheat.hooks = {}

    -- 6. Ресторим __namecall (silent aim + anti-drown).
    if cheat._namecall_old then
        pcall(hookmetamethod, game, "__namecall", cheat._namecall_old)
        cheat._namecall_old = nil
    end

    cheat.aa_enabled = false
    cheat.fake_lag_enabled = false
    cheat.desync_enabled = false
    cheat.real_CFrame = nil
    -- Restore physics rate on unload
    pcall(function()
        if getfflag then
            local rate = getfflag("S2PhysicsSenderRate")
            local bw = getfflag("PhysicsSenderMaxBandwidthBps")
            if rate and bw then
                setfflag("S2PhysicsSenderRate", tostring(rate))
                setfflag("PhysicsSenderMaxBandwidthBps", tostring(bw))
            end
        end
    end)

    -- 7. Ресторим InstantMosin recoil (если был включён). FIX #18: lookup by name now.
    pcall(function()
        local ammo = ReplicatedStorage:FindFirstChild("AmmoTypes")
        if not ammo then return end
        for name, v in pairs(original_recoils) do
            local a = ammo:FindFirstChild(name)
            if a then pcall(function() a:SetAttribute("RecoilStrength", v) end) end
        end
    end)

    -- 8. Удаляем foreign GUI (inventory viewers, noclip, skin/gun browser).
    pcall(function()
        for _, g in ipairs(cheat.guis) do
            pcall(function() g:Destroy() end)
        end
    end)
    cheat.guis = {}

    -- 9. Удаляем foreign parts (noclip probe, water platform).
    pcall(function()
        for _, p in ipairs(cheat.parts) do
            pcall(function() p:Destroy() end)
        end
    end)
    cheat.parts = {}

    -- 10. Ресторим lighting (potato/time/ambient/skybox + fullbright/noshadows baseline).
    if cheat._lighting_restore then pcall(cheat._lighting_restore) end
    if cheat._baseline_lighting_restore then pcall(cheat._baseline_lighting_restore) end

    -- 11. Ресторим камеру/мышь (freecam/3rd person могли их изменить).
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        LocalPlayer.CameraMaxZoomDistance = 0.5
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.ReplicationFocus = nil
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end)

    -- 12. Снимаем глобальный флаг.
    getgenv().__zalupa_v1 = nil
end

cheat.EspLibrary.load()
Library:Notify({
    Title = "Zalupa.HooK",
    Description = "Loaded successfully. Welcome to Zalupa.HooK v1.5 Updated.",
    Time = 5
})

-- Регистрируем инстанс для re-exec гарда (BLOCK 00 вызовет unload при повторном запуске).
getgenv().__zalupa_v1 = cheat
