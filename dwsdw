cheat.staff_detected = cheat.staff_detected or {}

-- [BLOCK 15d] MISC TAB — Staff Detector (Mod/Tester/Content Creator detector)
-- Детектор администрации: по группам + поведенческий анализ альтов
-- Ловит модеров, тестеров и контент-мейкеров, включая тех кто на альтах без групп
-- ═══════════════════════════════════════════════════════════════════════════
;(function()
    local StaffDetectorGroup = Tabs.Misc:AddLeftGroupbox("Staff Detector")

    local SD_GROUP_ID = 3765739
    local SD_ROLE_MAP = {
        tester = {
            ["Tester"] = true,
            ["Test Coordinator"] = true,
        },
        content_creator = {
            ["Content Creator"] = true,
            ["Partner"] = true,
        },
        mod = {
            ["New Devs"] = true,
            ["Dev Team"] = true,
            ["Moderator"] = true,
            ["Head Moderator"] = true,
            ["Admin"] = true,
            ["Developer"] = true,
            ["Lead developer"] = true,
        },
    }

    local sd_enabled = false
    local sd_connections = {}
    local sd_player_data = {}
    local sd_scan_acc = 0

    -- Детект по группе: ТОЛЬКО GetRoleInGroup (возвращает имя роли строкой).
    -- НЕ используем GetRankInGroup как fallback — rank 1 = "Guest" (дефолтный ранг
    -- для ВСЕХ кто вступил в Roblox-группу ради бонусов), что даёт ложные срабатывания
    -- на каждом обычном игроке. GetRoleInGroup надёжна: возвращает "" если не в группе,
    -- или точное имя роли если в группе.
    local function sd_detect_group(player)
        local ok, role = pcall(function()
            return player:GetRoleInGroup(SD_GROUP_ID)
        end)
        if ok and type(role) == "string" and role ~= "" then
            if SD_ROLE_MAP.tester[role] then return "tester", role end
            if SD_ROLE_MAP.content_creator[role] then return "content_creator", role end
            if SD_ROLE_MAP.mod[role] then return "mod", role end
        end
        return nil, nil
    end

    -- +2 балла: Invisible — все BaseParts (кроме HRP) прозрачные, но жив
    local function sd_check_invisible(character)
        if not character then return false end
        local hum = character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if part.Transparency < 0.99 then
                    return false
                end
            end
        end
        return true
    end

    -- +1 балл: Naked — нет оружия/брони в инвентаре (Shirt/Pants OK)
    local function sd_check_naked(player)
        local pfolder = ReplicatedStorage:FindFirstChild("Players")
        local pdata = pfolder and pfolder:FindFirstChild(player.Name)
        local pinv = pdata and pdata:FindFirstChild("Inventory")
        if not pinv then return false end

        for _, item in ipairs(pinv:GetChildren()) do
            local slot_attr = item:GetAttribute("Slot") or ""

            -- 1. Оружие с прикреплёнными модулями (Attachments)
            local atts = item:FindFirstChild("Attachments")
            if atts and #atts:GetChildren() > 0 then
                return false
            end

            -- 2. Оружие в хотбаре (slot-based — для оружия без Attachments)
            if slot_attr:find("ItemBack")
               or slot_attr:find("ItemHip")
               or slot_attr == "Melee" then
                return false
            end

            -- 3. Броня
            if slot_attr:find("ClothingHeadware")
               or slot_attr:find("ClothingChestRig")
               or slot_attr:find("ClothingLegArmor") then
                return false
            end

            -- 4. Рюкзак — только если внутри что-то есть
            if slot_attr:find("ClothingBackpack") then
                local inner = item:FindFirstChild("Inventory")
                if inner and #inner:GetChildren() > 0 then
                    return false
                end
            end

            -- 5. Equipment (GPS, Map, Compass, Lighter)
            if slot_attr:find("Equipment") then
                return false
            end

            -- 6. ClothingMask НЕ проверяем — в PD она может быть дефолтной при спавне.
            -- Если уверен что это лут — раскомментируй:
            -- if slot_attr:find("ClothingMask") then return false end
        end

        return true
    end

    -- +1 балл: No Tag — нет включённого BillboardGui на Head
    local function sd_check_no_tag(character)
        if not character then return false end
        local head = character:FindFirstChild("Head")
        if not head then return false end
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("BillboardGui") and child.Enabled then
                return false
            end
        end
        return true
    end

    -- +1 балл: God Mode — Health > 1000 или ForceField
    local function sd_check_god_mode(character)
        if not character then return false, false end
        local hum = character:FindFirstChildOfClass("Humanoid")
        local god_health = hum and hum.Health > 1000 or false
        local has_ff = character:FindFirstChildOfClass("ForceField") ~= nil
        return god_health, has_ff
    end

    -- Полный скан одного игрока
    local function sd_scan_player(player, data)
        if player == LocalPlayer then return 0, {} end
        local character = player.Character
        if not character then return 0, {} end

        if data.last_character ~= character then
            data.last_character = character
            data.last_pos = nil
            data.still_time = 0
        end

        local score = 0
        local reasons = {}

        if sd_check_invisible(character) then
            score = score + 2
            reasons[#reasons + 1] = "Invisible"
        end

        if sd_check_naked(player) then
            score = score + 1
            reasons[#reasons + 1] = "Naked"
        end

        if data.still_time and data.still_time >= 12 then
            score = score + 1
            reasons[#reasons + 1] = "Passive"
        end

        if sd_check_no_tag(character) then
            score = score + 1
            reasons[#reasons + 1] = "No Tag"
        end

        local god, ff = sd_check_god_mode(character)
        if god then
            score = score + 1
            reasons[#reasons + 1] = "God Mode"
        end
        if ff then
            score = score + 1
            reasons[#reasons + 1] = "ForceField"
        end

        return score, reasons
    end

    -- Асинхронная проверка группы (с задержкой 1 сек)
    local function sd_async_check(player)
        task.spawn(function()
            task.wait(1)
            if not sd_enabled then return end
            if not sd_player_data[player] then return end
            local gtype, grole = sd_detect_group(player)
            if gtype then
                sd_player_data[player].group_type = gtype
                sd_player_data[player].group_role = grole
                local icons = {
                    tester = "[TESTER]",
                    content_creator = "[CREATOR]",
                    mod = "[MOD]",
                }
                cheat.staff_detected[player] = { type = gtype, role = grole }
                local icons = {
                    tester = "[TESTER]",
                    content_creator = "[CREATOR]",
                    mod = "[MOD]",
                }
                local ru_titles = {
                    tester = "[ТЕСТЕР]",
                    content_creator = "[КРЕАТОР]",
                    mod = "[МОДЕРАТОР]",
                }
                local icon_str = (current_lang == "RU" and (ru_titles[gtype] or "[СТАФФ]"))
                               or (icons[gtype] or "[STAFF]")
                local desc = (current_lang == "RU")
                    and (icon_str .. " " .. player.Name .. " зашёл на сервер — " .. grole)
                    or (icon_str .. " " .. player.Name .. " joined — " .. grole)
                Library:Notify({
                    Title = (current_lang == "RU") and "Детектор персонала" or "Staff Detector",
                    Description = desc,
                    Time = 10,
                })
                task.spawn(function()
                    local s = Instance.new("Sound")
                    s.SoundId = "rbxassetid://4581728529"
                    s.Volume = 2
                    s.Parent = game:GetService("SoundService")
                    s:Play()
                    game:GetService("Debris"):AddItem(s, 5)
                end)
            end
        end)
    end

    local function sd_start()
        if sd_enabled then return end
        sd_enabled = true

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                sd_player_data[player] = {
                    group_type = nil,
                    group_role = nil,
                    last_pos = nil,
                    last_character = nil,
                    still_time = 0,
                    last_score = 0,
                    last_reasons = {},
                    notified = nil,
                }
                sd_async_check(player)
            end
        end

        sd_connections.player_added = Players.PlayerAdded:Connect(function(player)
            if player == LocalPlayer then return end
            sd_player_data[player] = {
                group_type = nil,
                group_role = nil,
                last_pos = nil,
                last_character = nil,
                still_time = 0,
                last_score = 0,
                last_reasons = {},
                notified = nil,
            }
            sd_async_check(player)
        end)

        sd_connections.player_removing = Players.PlayerRemoving:Connect(function(player)
            local data = sd_player_data[player]
            if data and data.group_type then
                local leave_desc = (current_lang == "RU")
                    and (player.Name .. " (" .. (data.group_role or data.group_type) .. ") вышел")
                    or (player.Name .. " (" .. (data.group_role or data.group_type) .. ") left")
                Library:Notify({
                    Title = (current_lang == "RU") and "Детектор персонала" or "Staff Detector",
                    Description = leave_desc,
                    Time = 5,
                })
                cheat.staff_detected[player] = nil
            end
            sd_player_data[player] = nil
        end)

        sd_scan_acc = 0
        sd_connections.scan = cheat.utility.new_heartbeat(function(delta)
            if not sd_enabled then return end
            sd_scan_acc = sd_scan_acc + delta
            if sd_scan_acc < 1.5 then return end
            sd_scan_acc = 0

            for player, data in pairs(sd_player_data) do
                if not player or not player.Parent then
                    sd_player_data[player] = nil
                    continue
                end

                local character = player.Character
                if character then
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if data.last_pos then
                            local flat_dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
                                             - Vector3.new(data.last_pos.X, 0, data.last_pos.Z)).Magnitude
                            local speed = flat_dist / 1.5
                            if speed < 2 then
                                data.still_time = data.still_time + 1.5
                            else
                                data.still_time = 0
                            end
                        end
                        data.last_pos = hrp.Position
                    end
                end

                if data.group_type then continue end

                local score, reasons = sd_scan_player(player, data)
                data.last_score = score
                data.last_reasons = reasons

                local has_inv, has_naked, has_passive = false, false, false
                for _, r in ipairs(reasons) do
                    if r == "Invisible" then has_inv = true end
                    if r == "Naked" then has_naked = true end
                    if r == "Passive" then has_passive = true end
                end

                if has_inv and has_naked and has_passive then
                    -- 100% стафф на альте (красное + звук)
                    if data.notified ~= "confirmed" then
                        data.notified = "confirmed"
                        cheat.staff_detected[player] = { type = "alt_mod", role = "Behavioral" }
                        local conf_desc = (current_lang == "RU")
                            and ("ПОДТВЕРЖДЁННЫЙ СТАФФ-АЛЬТ: " .. player.Name
                                .. " (" .. table.concat(reasons, ", ") .. ")")
                            or ("CONFIRMED STAFF ALT: " .. player.Name
                                .. " (" .. table.concat(reasons, ", ") .. ")")
                        Library:Notify({
                            Title = (current_lang == "RU") and "Детектор персонала" or "Staff Detector",
                            Description = conf_desc,
                            Time = 15,
                        })
                        task.spawn(function()
                            local s = Instance.new("Sound")
                            s.SoundId = "rbxassetid://4581728529"
                            s.Volume = 2
                            s.Parent = game:GetService("SoundService")
                            s:Play()
                            game:GetService("Debris"):AddItem(s, 5)
                        end)
                    end
                elseif score >= 4 and has_inv then
                    -- Подозрительный (жёлтое) — нужен Invisible + минимум 2 других триггера
                    -- Invisible(2) + Passive(1) = 3 (модер с дефолтным ножом)
                    -- Invisible(2) + Naked(1) = 3 (тестер на альте)
                    -- Invisible(2) + NoTag(1) = 3 и т.д.
                    if data.notified ~= "suspicious" then
                        data.notified = "suspicious"
                        local susp_desc = (current_lang == "RU")
                            and ("Подозрительный: " .. player.Name
                                .. " (" .. score .. " баллов: " .. table.concat(reasons, ", ") .. ")")
                            or ("Suspicious: " .. player.Name
                                .. " (" .. score .. " pts: " .. table.concat(reasons, ", ") .. ")")
                        Library:Notify({
                            Title = (current_lang == "RU") and "Детектор персонала" or "Staff Detector",
                            Description = susp_desc,
                            Time = 10,
                        })
                    end
                else
                    if data.notified and score < 2 then
                        data.notified = nil
                    end
                end
            end
        end)
    end

    local function sd_stop()
        sd_enabled = false
        for _, conn in pairs(sd_connections) do
            if conn and type(conn) == "table" and conn.Disconnect then
                pcall(function() conn:Disconnect() end)
            elseif conn and type(conn) == "userdata" then
                pcall(function() conn:Disconnect() end)
            end
        end
        sd_connections = {}
        sd_player_data = {}
        if cheat.staff_detected then
            table.clear(cheat.staff_detected)
        end
    end

    StaffDetectorGroup:AddToggle("staff_detector_on", {
        Text = "Enable Staff Detector",
        Default = false,
        Tooltip = "Detect moderators/testers/creators by group role + behavioral analysis for alts without groups",
        Callback = function(v)
            if v then
                sd_start()
            else
                sd_stop()
            end
        end
    })

    if cheat.raw_conns then
        table.insert(cheat.raw_conns, {
            Disconnect = function()
                sd_stop()
            end
        })
    end
end)()

