-- Draggable frame helper (ported from v8) — BackgroundTransparency=1 frames capture clicks via Active=true + InputBegan
-- Handles AnchorPoint correctly by recomputing Position on each delta.
local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            -- Drop AnchorPoint while dragging so position math is straightforward.
            -- The frame will still appear in the same place because we preserve the
            -- screen-space pixel position via the offset change.
            local ap = frame.AnchorPoint
            if ap and (ap.X ~= 0 or ap.Y ~= 0) then
                -- Convert current anchor-based position to top-left anchored position
                local abs = frame.AbsolutePosition
                local sz = frame.AbsoluteSize
                local vp = frame.Parent and frame.Parent.AbsoluteSize or Vector2.new(workspace.CurrentCamera.ViewportSize.X, workspace.CurrentCamera.ViewportSize.Y)
                frame.AnchorPoint = Vector2.new(0, 0)
                frame.Position = UDim2.new(0, abs.X, 0, abs.Y)
                startPos = frame.Position
                dragStart = input.Position
            end
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

