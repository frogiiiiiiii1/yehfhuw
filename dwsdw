-- updateClient hook (recoil, spread, bob, instant aim, unlock firemodes, rapid fire)
-- Continuous background scanner re-hooks new spring tables after respawn
cheat.alive = true
task.spawn(function()
    local got_that = false
    -- Spring table hooks (more precise than updateClient): recoilPos/recoilRot/cameraRecoil/walkCycle/gunSway/sway/strafeTilt/jumpTilt/jumpCameraTilt
    local recoil_spring_names = {recoilPos = true, recoilRot = true, cameraRecoil = true}
    local bob_spring_names = {walkCycle = true, sprintCycle = true, gunSway = true, sway = true, strafeTilt = true, jumpTilt = true, jumpCameraTilt = true}
    local function hook_spring_table(gc)
        if rawget(gc, "springs") and rawget(gc, "characterAnimations") and not gc._zh_springs_hooked then
            gc._zh_springs_hooked = true
            local springs = gc.springs
            for s_name, spring in pairs(springs) do
                if type(spring) == "table" and rawget(spring, "shove") and rawget(spring, "update") and not spring._zh_hooked then
                    spring._zh_hooked = true
                    local old_shove = spring.shove
                    local old_update = spring.update
                    spring.shove = function(self, force, ...)
                        if norecoil and recoil_spring_names[s_name] then
                            local r_mult = (recoil_percent or 0) / 100
                            if r_mult <= 0 then return end
                            if typeof(force) == "Vector3" then force = force * r_mult end
                            if typeof(force) == "number" then force = force * r_mult end
                        end
                        if nobob and bob_spring_names[s_name] then
                            return
                        end
                        return old_shove(self, force, ...)
                    end
                    spring.update = function(self, ...)
                        if norecoil and recoil_spring_names[s_name] then
                            local r_mult = (recoil_percent or 0) / 100
                            if r_mult <= 0 then
                                self.p = Vector3.zero
                                self.v = Vector3.zero
                                self.target = Vector3.zero
                                return Vector3.zero
                            end
                        end
                        if nobob and bob_spring_names[s_name] then
                            self.p = Vector3.zero
                            self.v = Vector3.zero
                            self.target = Vector3.zero
                            return Vector3.zero
                        end
                        return old_update(self, ...)
                    end
                end
            end
            return true
        end
        return false
    end
    repeat
        local gc_list = getgc(true)
        for i = 1, #gc_list do
            local gc = gc_list[i]
            if type(gc) == "table" then
                if hook_spring_table(gc) then
                    got_that = true
                end
                if type(rawget(gc,"shove")) == "function" and type(rawget(gc,"update")) == "function" and not gc._zh_oldspring_hooked then
                    gc._zh_oldspring_hooked = true
                    new_hook(gc.shove, function(old, ...)
                        if norecoil then pcall(old, ...) return end
                        return old(...)
                    end, true)
                    new_hook(gc.update, function(old, ...)
                        -- nobob handled by Check 1 (spring-specific hooks above)
                        -- which checks bob_spring_names[s_name] to only zero bob springs.
                        -- This old-style hook must NOT zero ALL springs or it breaks recoil/aim.
                        return old(...)
                    end, true)
                end
                if rawget(gc, "updateClient") and not gc._zh_uc_hooked then
                    gc._zh_uc_hooked = true
                    new_hook(gc.updateClient, function(old, ...)
                        local args = {...}; local argc = select("#", ...)
                        if args[1] then
                            if norecoil then
                                local r_mult = (recoil_percent or 0) / 100
                                if rawget(args[1], "Recoil") then
                                    pcall(function() args[1].Recoil = args[1].Recoil * r_mult end)
                                end
                                if rawget(args[1], "RecoilPattern") then
                                    pcall(function() args[1].RecoilPattern = args[1].RecoilPattern * r_mult end)
                                end
                            end
                            if silent_aim.nospread then
                                local s_mult = (spread_percent or 0) / 100
                                if rawget(args[1], "Spread") then
                                    pcall(function() args[1].Spread = args[1].Spread * s_mult end)
                                end
                                if rawget(args[1], "HipSpread") then
                                    pcall(function() args[1].HipSpread = args[1].HipSpread * s_mult end)
                                end
                                if rawget(args[1], "AimSpread") then
                                    pcall(function() args[1].AimSpread = args[1].AimSpread * s_mult end)
                                end
                            end
                            if nobob then
                                pcall(function()
                                    if rawget(args[1], "BobIntensity") then args[1].BobIntensity = 0 end
                                    if rawget(args[1], "SwayIntensity") then args[1].SwayIntensity = 0 end
                                    if rawget(args[1], "Sway") then args[1].Sway = 0 end
                                    if rawget(args[1], "AimSway") then args[1].AimSway = 0 end
                                    if rawget(args[1], "CameraSway") then args[1].CameraSway = 0 end
                                    if rawget(args[1], "CameraBob") then args[1].CameraBob = 0 end
                                    if rawget(args[1], "WalkBob") then args[1].WalkBob = 0 end
                                    if rawget(args[1], "IdleSway") then args[1].IdleSway = 0 end
                                    if rawget(args[1], "WalkSway") then args[1].WalkSway = 0 end
                                end)
                            end
                            if instantaim then args[1].AimInSpeed = 0; args[1].AimOutSpeed = 0 end
                            if unlock_firemodes and rawget(args[1], "FireModes") then
                                if not table.find(args[1].FireModes, "Auto") then
                                    table.insert(args[1].FireModes, "Auto")
                                end
                                if not table.find(args[1].FireModes, "Semi") then
                                    table.insert(args[1].FireModes, "Semi")
                                end
                            end
                            if forceauto or unlock_firemodes then
                                args[1].FireMode = "Auto"
                            end
                            if rapid_fire then args[1].FireRate = rapid_fire_delay / shootspeed end
                        end
                        return old(unpack(args, 1, argc))
                    end, true)
                    got_that = true
                end
            end
            if i % 300 == 0 then task.wait() end
        end
        if not got_that then task.wait(1) end
    until got_that

    -- Continuous background scanner: re-hooks new spring tables
    -- after respawn. Runs at 5s interval ONLY while norecoil OR nobob is active.
    task.spawn(function()
        local next_scan = 0
        while cheat.alive do
            task.wait(1)
            if not (norecoil or nobob) then continue end
            local now = os.clock()
            if now < next_scan then continue end
            next_scan = now + 5
            pcall(function()
                local gc_list = getgc(true)
                for i = 1, #gc_list do
                    local gc = gc_list[i]
                    if type(gc) == "table" then
                        hook_spring_table(gc)
                    end
                    if i % 500 == 0 then task.wait() end
                end
            end)
        end
    end)
end)

