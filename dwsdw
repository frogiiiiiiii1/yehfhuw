    local rows = {"user", "dist", "weapon", "kd", "time", "reps", "vis"}
    for i, row in ipairs(rows) do
        local l, v = create_label(row)
        tipanel.labels[row] = l
        tipanel.values[row] = v
    end
    tipanel.hours = cheat.utility.new_drawing("Text", { Visible=false, Font=Drawing.Fonts.Plex, Size=11, Color=Color3.fromRGB(160,160,170), Text="0h", ZIndex=12, Outline=true, Center=true })
    tipanel.hpbg = cheat.utility.new_drawing("Square", { Visible=false, Filled=true, Color=Color3.fromRGB(25,25,30), Size=Vector2.new(175,8), ZIndex=11, Transparency=1 })
    tipanel.hpfill = cheat.utility.new_drawing("Square", { Visible=false, Filled=true, Color=tipanel_settings.accentcolor, Size=Vector2.new(0,8), ZIndex=12, Transparency=1 })
    tipanel.hptext = cheat.utility.new_drawing("Text", { Visible=false, Font=Drawing.Fonts.Plex, Size=10, Color=Color3.new(1,1,1), Text="100/100", ZIndex=13, Outline=true })

    local _rb, _rot = 0, 0
    local _transp, _reverse = 0, false
    local _cgi = GuiInset
    local _cmc = LocalPlayer:GetMouse()
    local math_cos, math_atan, math_pi, math_sin = math.cos, math.atan, math.pi, math.sin
    local function DEG2RAD(x) return x * math_pi / 180 end
    local function RAD2DEG(x) return x * 180 / math_pi end

    cheat.utility.new_renderstepped(function(delta)
        local target = silent_aim.target_part and silent_aim.target_part.Parent
        local info_visible = silent_aim.tipanel_enabled and target ~= nil
        -- Target Info Panel visibility
        if tipanel._visible_cache ~= info_visible then
            tipanel._visible_cache = info_visible
            tipanel.bg.Visible = info_visible
            tipanel.border.Visible = info_visible
            tipanel.inline.Visible = info_visible
            tipanel.accent.Visible = info_visible
            tipanel.header.Visible = info_visible
            for _, g in ipairs(tipanel.glow) do g.Visible = info_visible end
            tipanel_avatar_gui.Enabled = info_visible
            tipanel_avatar_label.Visible = info_visible
            tipanel.hours.Visible = info_visible
            tipanel.avatar_border.Visible = info_visible
            for _, l in pairs(tipanel.labels) do l.Visible = info_visible end
            for _, v in pairs(tipanel.values) do v.Visible = info_visible end
            tipanel.hpbg.Visible = info_visible
            tipanel.hpfill.Visible = info_visible
            tipanel.hptext.Visible = info_visible
        end
        target_line.Visible = info_visible and silent_aim.target_line

        if info_visible then
            local mousepos = Vector2.new(_cmc.X, _cmc.Y + _cgi.Y)
            -- drag-and-drop
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and Library and Library.Opened then
                local in_header = mousepos.X >= tipanel.pos.X and mousepos.X <= tipanel.pos.X + tipanel.width
                    and mousepos.Y >= tipanel.pos.Y and mousepos.Y <= tipanel.pos.Y + 25
                if in_header or tipanel.dragging then
                    if not tipanel.dragging then
                        tipanel.dragging = true
                        tipanel.dragoffset = tipanel.pos - mousepos
                    end
                    local vp = Camera.ViewportSize
                    local dragged = mousepos + tipanel.dragoffset
                    tipanel.pos = Vector2.new(
                        math.clamp(dragged.X, 0, math.max(0, vp.X - tipanel.width)),
                        math.clamp(dragged.Y, 0, math.max(0, vp.Y - tipanel.height))
                    )
                    silent_aim.tipanel_x = math.floor(tipanel.pos.X + 0.5)
                    silent_aim.tipanel_y = math.floor(tipanel.pos.Y + 0.5)
                end
            else
                tipanel.dragging = false
                local vp = Camera.ViewportSize
                local cx = math.clamp(tonumber(silent_aim.tipanel_x) or 20, 0, math.max(0, vp.X - tipanel.width))
                local cy = math.clamp(tonumber(silent_aim.tipanel_y) or 350, 0, math.max(0, vp.Y - tipanel.height))
                tipanel.pos = Vector2.new(cx, cy)
            end
            local p = tipanel.pos
            tipanel.bg.Position = p
            tipanel.bg.Size = Vector2.new(tipanel.width, tipanel.height)
            tipanel.bg.Transparency = silent_aim.tipanel_bgtrans or tipanel_settings.bgtrans
            tipanel.border.Position = p
            tipanel.border.Size = tipanel.bg.Size
            tipanel.inline.Position = p + Vector2.new(2, 2)
            tipanel.inline.Size = tipanel.bg.Size - Vector2.new(4, 4)
            tipanel.accent.Position = p + Vector2.new(3, 21)
            tipanel.accent.Size = Vector2.new(tipanel.width - 6, 1)
            tipanel.header.Position = p + Vector2.new(10, 4)
            tipanel.glow[1].Position = p - Vector2.new(1, 1)
            tipanel.glow[1].Size = tipanel.bg.Size + Vector2.new(2, 2)
            tipanel.glow[2].Position = p + Vector2.new(1, 1)
            tipanel.glow[2].Size = tipanel.bg.Size - Vector2.new(2, 2)
            tipanel_avatar_label.Position = UDim2.new(0, p.X + 8, 0, p.Y + 28)
            tipanel.avatar_border.Position = p + Vector2.new(7, 27)
            tipanel.hours.Position = p + Vector2.new(40, 92)
            local lx, rx = p.X + 84, p.X + tipanel.width - 10
            local y_spacing = 16
            for i, row in ipairs({"user", "dist", "weapon", "kd", "time", "reps", "vis"}) do
                local y = p.Y + 28 + (i-1) * y_spacing
                tipanel.labels[row].Position = Vector2.new(lx, y)
                tipanel.values[row].Position = Vector2.new(rx - tipanel.values[row].TextBounds.X, y)
            end
            tipanel.hpbg.Position = p + Vector2.new(84, 140)
            tipanel.hpfill.Position = p + Vector2.new(84, 140)
            tipanel.hptext.Position = p + Vector2.new(84 + 175/2 - tipanel.hptext.TextBounds.X/2, 139)

            -- data update every 0.15s
            local panel_data_due = tipanel._data_target ~= target or os.clock() >= (tipanel._next_data_update or 0)
            if panel_data_due then
                tipanel._data_target = target
                tipanel._next_data_update = os.clock() + 0.15
                local player = Players:GetPlayerFromCharacter(target)
                local hum = target:FindFirstChildOfClass("Humanoid")
                local k_d = "0/0"
                local dist_val = "?m"
                local weapon_val = "None"
                local reps_val = "0"
                local time_val = "0h"
                if player then
                    local pfolder = ReplicatedStorage:FindFirstChild("Players") and ReplicatedStorage.Players:FindFirstChild(player.Name)
                    local stats_obj = pfolder and (pfolder:FindFirstChild("WipeStatistics", true) or pfolder:FindFirstChild("Statistics", true))
                    local h_stat = pfolder and pfolder:FindFirstChild("Statistics", true)
                    local hours = h_stat and h_stat:GetAttribute("TimePlayed") or 0
                    time_val = math.floor(hours / 3600) .. "h"
                    tipanel.hours.Text = time_val
                    if stats_obj then
                        local kills = stats_obj:GetAttribute("Kills") or 0
                        local deaths = stats_obj:GetAttribute("Deaths") or 0
                        k_d = kills .. "/" .. deaths
                    end
                    -- distance to target
                    local target_hr = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
                    if target_hr then
                        dist_val = math.floor((Camera.CFrame.p - target_hr.Position).Magnitude / 3) .. "m"
                    end
                    -- equipped weapon name
                    local pvars = pfolder and pfolder:FindFirstChild("GameplayVariables", true)
                    local eq_tool = pvars and pvars:FindFirstChild("EquippedTool")
                    if eq_tool and eq_tool.Value then weapon_val = tostring(eq_tool.Value) end
                    -- reports count (from UAC.Reports)
                    local uac = pfolder and pfolder:FindFirstChild("UAC", true)
                    local rep_folder = uac and uac:FindFirstChild("Reports")
                    if rep_folder then
                        local total_reps = 0
                        local attr1 = rep_folder:GetAttribute("1")
                        if typeof(attr1) == "number" then
                            total_reps = attr1
                        else
                            for _, count in pairs(rep_folder:GetAttributes()) do
                                if typeof(count) == "number" then total_reps = total_reps + count end
                            end
                        end
                        reps_val = tostring(total_reps)
                    end
                    local is_vis = silent_aim.isvisible == true
                    local is_manip = silent_aim.manipulated == true and silent_aim.manipulated_origin ~= nil
                    tipanel.values["vis"].Text = is_vis and "Visible" or (is_manip and "Manipulated" or "Hidden")
                    tipanel.values["vis"].Color = (is_vis or is_manip) and tipanel_settings.accentcolor or Color3.fromRGB(175,175,175)
                    -- avatar via rbxthumb:// (native, no HttpGet)
                    if tipanel._avatar_userid ~= player.UserId then
                        tipanel._avatar_userid = player.UserId
                        tipanel_avatar_label.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", player.UserId)
                    end
                end
                tipanel.values["user"].Text = player and player.Name or target.Name
                tipanel.values["dist"].Text = dist_val
                tipanel.values["weapon"].Text = weapon_val
                tipanel.values["kd"].Text = k_d
                tipanel.values["time"].Text = time_val
                tipanel.values["reps"].Text = reps_val
                if hum then
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    tipanel.hpfill.Size = Vector2.new(175 * pct, 8)
                    tipanel.hptext.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                end
            end
            -- target line
            if silent_aim.target_line then
                local head_pos, on_screen = Camera:WorldToViewportPoint(silent_aim.target_part.Position)
                if on_screen then
                    target_line.From = Vector2.new(_cmc.X, _cmc.Y + _cgi.Y)
                    target_line.To = Vector2.new(head_pos.X, head_pos.Y)
                else
                    target_line.Visible = false
                end
            end
        end

        -- Crosshair rendering
        if cursor.Enabled then
            _rb = (_rb + delta * 0.5) % 1
            local color = cursor.Color
            local custom_target_pos = nil
            if cursor.OnTarget and silent_aim.target_part then
                local screen_pos, on_screen = Camera:WorldToViewportPoint(silent_aim.target_part.Position)
                if on_screen then
                    custom_target_pos = Vector2.new(screen_pos.X, screen_pos.Y)
                end
            end
            local pos
            if custom_target_pos then
                pos = custom_target_pos
            elseif cursor.CustomPos then
                pos = cursor.Position
            else
                pos = Vector2.new(_cmc.X, _cmc.Y + _cgi.Y)
            end
            if cursor.rainbow then color = Color3.fromHSV(_rb, 1, 1) else color = cursor.Color end
            if _transp <= 1.5 + cursor.Text.LogoFadingOffset and not _reverse then
                _transp = _transp + (cursor.Speed * 10) * delta
                if _transp >= 1.5 + cursor.Text.LogoFadingOffset then _reverse = true end
            elseif _reverse then
                _transp = _transp - (cursor.Speed * 10) * delta
                if _transp <= 0 - cursor.Text.LogoFadingOffset then _reverse = false end
            end
            logotext.Position = Vector2.new(pos.X, (pos + Vector2.new(0, cursor.Radius + 5)).Y)
            logotext.Transparency = math.clamp(_transp, 0, 1)
            logotext.Visible = cursor.Text.Logo
            logotext.Color = cursor.Text.LogoColor
            logotext.Font = cursor.Font
            if cursor.sussy then
                local a = cursor.Radius - 10
                local gamma = math_atan(a / a)
                if _rot >= 90 then _rot = 0 end
                for i = 1, 4 do
                    local p_0 = (a * math_sin(DEG2RAD(_rot + (i * 90))))
                    local p_1 = (a * math_cos(DEG2RAD(_rot + (i * 90))))
                    local p_2 = ((a / math_cos(gamma)) * math_sin(DEG2RAD(_rot + (i * 90) + RAD2DEG(gamma))))
                    local p_3 = ((a / math_cos(gamma)) * math_cos(DEG2RAD(_rot + (i * 90) + RAD2DEG(gamma))))
                    lines[i][1].From = Vector2.new(pos.X, pos.Y)
                    lines[i][1].To = Vector2.new(pos.X + p_0, pos.Y - p_1)
                    lines[i][1].Color = color
                    lines[i][1].Thickness = cursor.Thickness
                    lines[i][1].Visible = true
                    lines[i][3].From = Vector2.new(pos.X + p_0, pos.Y - p_1)
                    lines[i][3].To = Vector2.new(pos.X + p_2, pos.Y - p_3)
                    lines[i][3].Color = color
                    lines[i][3].Thickness = cursor.Thickness
                    lines[i][3].Visible = true
                end
                -- FIX #20: bounded modulo (was: unbounded float growth → precision loss after long sessions)
                _rot = (_rot + (cursor.Speed * delta * 1000)) % 360
            else
                _rot = (_rot + (cursor.Speed * 10) * delta) % 90
                dot.Visible = cursor.Dot
                dot.Color = color
                dot.Position = Vector2.new(pos.X - 1, pos.Y - 1)
                outline.Visible = cursor.Outline and cursor.Dot
                outline.Position = Vector2.new(pos.X - 2, pos.Y - 2)
                for index, line in pairs(lines) do
                    local radius = cursor.Radius
                    local inner_base = radius - cursor.Length
                    local outer_radius, inner_radius
                    if cursor.Resize then
                        outer_radius = radius + ((radius * math_sin(_rot)) / 9)
                        inner_radius = inner_base - (cursor.TheGap and ((inner_base * math_cos(_rot)) / 4) or ((inner_base * math_cos(_rot)) - 4))
                    else
                        outer_radius = radius
                        inner_radius = inner_base - (cursor.TheGap and (inner_base / cursor.Gap) or (inner_base - cursor.Gap))
                    end
                    local outline_outer_radius = radius + 1
                    local outline_inner_base = inner_base + 1
                    local outline_inner_radius = outline_inner_base - (cursor.TheGap and (outline_inner_base / cursor.Gap) or (outline_inner_base - cursor.Gap))
                    local theta = _rot + (index * (math_pi / 2))
                    local theta_cos, theta_sin = math_cos(theta), math_sin(theta)
                    line[1].Visible = true
                    line[1].Color = color
                    line[1].From = Vector2.new(pos.X + theta_cos * inner_radius, pos.Y + theta_sin * inner_radius)
                    line[1].To = Vector2.new(pos.X + theta_cos * outer_radius, pos.Y + theta_sin * outer_radius)
                    line[1].Thickness = cursor.Thickness
                    line[2].Visible = cursor.Outline
                    line[2].From = Vector2.new(pos.X + theta_cos * outline_inner_radius, pos.Y + theta_sin * outline_inner_radius)
                    line[2].To = Vector2.new(pos.X + theta_cos * outline_outer_radius, pos.Y + theta_sin * outline_outer_radius)
                    line[2].Thickness = cursor.Thickness + 2.5
                    line[3].Visible = false
                end
            end
        else
            dot.Visible = false
            outline.Visible = false
            logotext.Visible = false
            for index, line in pairs(lines) do
                line[1].Visible = false
                line[2].Visible = false
                line[3].Visible = false
            end
        end
    end)
end)()


