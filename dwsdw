-- Обёртка над hookfunction: сохраняет оригинал в cheat.hooks для restore на unload.
-- newf = function(old, ...) — вызывает old(...) чтобы дёрнуть оригинал.
local function new_hook(f, newf, usecclosure)
    if usecclosure then
        local old; old = hookfunction(f, newcclosure(function(...) return newf(old, ...) end))
        cheat.hooks[#cheat.hooks + 1] = { func = f, old = old }
        return old
    else
        local old; old = hookfunction(f, function(...) return newf(old, ...) end)
        cheat.hooks[#cheat.hooks + 1] = { func = f, old = old }
        return old
    end
end

