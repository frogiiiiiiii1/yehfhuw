    -- ── Fake Lag ──────────────────────────────────────────────────────────
    AAGroup:AddToggle("fakelag_on", {
        Text = "Fake Lag",
        Default = false,
        Callback = function(v)
            fake_lag_enabled = v
            cheat.fake_lag_enabled = v
        end
    })
    AAGroup:AddSlider("fakelag_int", {
        Text = "Fake Lag Interval", Min = 1, Max = 7, Rounding = 1, Default = 4,
        Callback = function(v) fake_lag_interval = v / 10 end
    })
    AAGroup:AddToggle("vis_server_pos", {
        Text = "Visualize Fake Lag Pos",
        Default = false,
        Callback = function(v) visualize_server_pos = v end
    }):AddColorPicker("vis_server_color", {
        Default = Color3.fromRGB(255, 50, 50),
        Callback = function(v) visualize_color = v end
    })
    AAGroup:AddSlider("vis_server_trans", {
        Text = "Ghost Transparency", Min = 0, Max = 100, Rounding = 0, Default = 0,
        Callback = function(v) visualize_transparency = v / 100 end
    })

    -- ── UG Resolver ───────────────────────────────────────────────────────
    local ug_toggle = AAGroup:AddToggle("ug_resolver_tog", {
        Text = "UG Resolver",
        Default = false,
        Callback = function(v)
            ug_resolver_enabled = v
            if not v then ug_resolver_holding = false end
        end
    })
    ug_toggle:AddKeyPicker("ug_resolver_key", {
        Default = "J",
        Text = "UG Resolver Key",
        Mode = "Hold",
        SyncToggleState = true,
    })
    AAGroup:AddSlider("ug_resolver_d", {
        Text = "UG Resolver Depth", Min = 5, Max = 100, Rounding = 0, Default = 30,
        Callback = function(v) ug_resolver_depth = v end
    })

    -- ── Resolve Desync ────────────────────────────────────────────────────
    AAGroup:AddToggle("resolve_desync_tog", {
