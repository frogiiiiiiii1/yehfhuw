-- FIX #21: `Decoration` is a regular (public) Terrain property on modern Roblox.
-- The original code used `sethiddenproperty` which throws "Decoration is not a valid member"
-- on executors/games where the property is exposed normally. Detect once which path works
-- and use direct property access when available, fall back to sethiddenproperty otherwise.
--
-- FIX (dj regression): the original FIX #21 unconditionally tried to set
-- `Enum.TerrainDecoration.None` to disable grass — but that enum doesn't exist on
-- dj's Roblox version. On older builds `Terrain.Decoration` is a plain bool. We must
-- detect the value TYPE at first read and use a matching type when disabling:
--   • bool baseline    → write `false` to disable, original bool to restore
--   • enum baseline    → write that same enum back, OR if the baseline looks like
--     "no decoration" already (Decoration==0 or false), skip writing entirely
--   • unknown / no API → skip silently
local _terrain_decoration_strategy = nil  -- nil | "direct" | "hidden" | "none"
local _terrain_decoration_type    = nil   -- "bool" | "enum" | nil

local function _terrain_decoration_method()
    if _terrain_decoration_strategy ~= nil then return _terrain_decoration_strategy end
    -- Test 1: direct property read (regular Roblox API)
    local ok_read = pcall(function() local _ = workspace.Terrain.Decoration end)
    if ok_read then
        _terrain_decoration_strategy = "direct"
        return _terrain_decoration_strategy
    end
    -- Test 2: hidden property via executor API
    if sethiddenproperty and gethiddenproperty then
        local ok_hidden = pcall(gethiddenproperty, workspace.Terrain, "Decoration")
        if ok_hidden then
            _terrain_decoration_strategy = "hidden"
            return _terrain_decoration_strategy
        end
    end
    _terrain_decoration_strategy = "none"
    return _terrain_decoration_strategy
end

local function _terrain_decoration_get()
    local method = _terrain_decoration_method()
    if method == "direct" then
        local ok, val = pcall(function() return workspace.Terrain.Decoration end)
        if ok then
            -- Detect type on first successful read: bool or enum
            if _terrain_decoration_type == nil then
                if typeof(val) == "boolean" then _terrain_decoration_type = "bool"
                elseif typeof(val) == "EnumItem" then _terrain_decoration_type = "enum"
                else _terrain_decoration_type = "other" end
            end
            return val
        end
    elseif method == "hidden" then
        local ok, val = pcall(gethiddenproperty, workspace.Terrain, "Decoration")
        if ok then
            if _terrain_decoration_type == nil then
                if typeof(val) == "boolean" then _terrain_decoration_type = "bool"
                elseif typeof(val) == "EnumItem" then _terrain_decoration_type = "enum"
                else _terrain_decoration_type = "other" end
            end
            return val
        end
    end
    return nil
end

-- Returns the "disabled" value for the detected Decoration type — never throws.
--   • bool    → false
--   • enum    → Enum.TerrainDecoration.None if that enum exists on this Roblox
--               build, otherwise nil (no-op; the toggle will just do nothing)
--   • other   → nil
local function _terrain_decoration_disabled_value()
    if _terrain_decoration_type == "bool" then return false end
    if _terrain_decoration_type == "enum" then
        -- Pcall the enum lookup — on dj's Roblox `Enum.TerrainDecoration` doesn't exist
        local ok, val = pcall(function() return Enum.TerrainDecoration.None end)
        if ok then return val end
        return nil
    end
    return nil
end

local function _terrain_decoration_set(val)
    local method = _terrain_decoration_method()
    if method == "direct" then
        local ok = pcall(function() workspace.Terrain.Decoration = val end)
        return ok
    elseif method == "hidden" then
        local ok = pcall(sethiddenproperty, workspace.Terrain, "Decoration", val)
        return ok
    end
    return false
end

